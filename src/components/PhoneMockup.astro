---
import AppScreen from './AppScreen.astro';

interface Props {
  app: 'finly' | 'gps' | 'filtra';
  class?: string;
  compact?: boolean;
  label?: string;
}

const { app, class: className = '', compact = false, label } = Astro.props;
const labels = {
  finly: 'FINLY illustrative screen placeholder',
  gps: 'GPS Camera illustrative screen placeholder',
  filtra: 'Filtra illustrative screen placeholder',
};
---
<div class:list={['phone-mockup', `phone-mockup--${app}`, className, compact && 'phone-mockup--compact']} aria-label={label ?? labels[app]}>
  <div class="phone-frame">
    <div class="phone-island" aria-hidden="true"></div>
    <AppScreen app={app} compact={compact} />
  </div>
  <span class="phone-label">{label ?? 'Illustrative interface — replace with the actual app screenshot'}</span>
</div>
