---
import AppScreen from './AppScreen.astro';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<section class="applications section-pad" id="applications" aria-labelledby="applications-title">
  <div class="container">
    <div class="section-heading section-heading--split" data-reveal>
      <div>
        <span class="eyebrow"><span>03</span> / THE PRODUCT COLLECTION</span>
        <h2 id="applications-title">Designed to make<br /><em>a difference.</em></h2>
      </div>
      <p>Purpose-built Android applications, each created to solve a different everyday challenge — with the same care for clarity, usefulness and experience.</p>
    </div>
    <article class="product-feature product-feature--finly" data-reveal>
      <div class="product-feature__copy">
        <div class="product-feature__meta"><span class="product-number">01</span><span class="eyebrow">PERSONAL FINANCE</span><span class="availability availability--live"><i></i> LIVE ON GOOGLE PLAY</span></div>
        <h3>Money management,<br /><em>made clearer.</em></h3>
        <p class="product-feature__description">Take control of your money with FINLY — a premium, distraction-free expense manager that makes it easier to understand where your money goes and make smarter everyday decisions.</p>
        <ul class="feature-points">
          <li><span class="feature-check">↗</span> 100% ad-free, with no data tracking</li>
          <li><span class="feature-check">↗</span> Offline income and expense tracking</li>
          <li><span class="feature-check">↗</span> Future and recurring transactions</li>
          <li><span class="feature-check">↗</span> Budgets, alerts, analytics and pie charts</li>
          <li><span class="feature-check">↗</span> Receipt photos and digital invoice attachments</li>
          <li><span class="feature-check">↗</span> App Lock and Hide Balance controls</li>
          <li><span class="feature-check">↗</span> Local backups and personal Google Drive sync</li>
          <li><span class="feature-check">↗</span> PDF and CSV transaction-ledger exports</li>
        </ul>
        <div class="product-feature__actions">
          <a class="button button--primary" href="https://play.google.com/store/apps/details?id=com.prithveeshbhat.finly&amp;hl=en" target="_blank" rel="noopener noreferrer">Get FINLY on Google Play <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`${base}apps/finly/`}>Explore FINLY <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="product-feature__visual product-feature__visual--finly">
        <div class="product-feature__visual-glow" aria-hidden="true"></div>
        <div class="product-feature__device"><div class="device-notch"></div><AppScreen app="finly" /></div>
        <div class="product-float-card product-float-card--finly"><span class="float-card-icon">✳</span><span><b>100% AD-FREE</b><small>No interruptions. Just clarity.</small></span></div>
        <span class="product-feature__visual-caption">FINLY / PERSONAL FINANCE</span>
      </div>
    </article>
    <article class="product-feature product-feature--gps" data-reveal>
      <div class="product-feature__copy">
        <div class="product-feature__meta"><span class="product-number">02</span><span class="eyebrow">LOCATION PHOTOGRAPHY</span><span class="availability availability--live"><i></i> LIVE ON GOOGLE PLAY</span></div>
        <h3>Capture more than<br /><em>a photograph.</em></h3>
        <p class="product-feature__description">GPS Camera brings location, time and context to your photos and videos — helping turn field captures into organised, useful records.</p>
        <ul class="feature-points feature-points--indigo">
          <li><span class="feature-check">↗</span> GPS and timestamped photo / video captures</li>
          <li><span class="feature-check">↗</span> Project folders and organised records</li>
          <li><span class="feature-check">↗</span> Professional stamps and company branding</li>
          <li><span class="feature-check">↗</span> Map details and photo editing</li>
          <li><span class="feature-check">↗</span> PDF site reports</li>
        </ul>
        <div class="product-feature__actions">
          <a class="button button--indigo" href="https://play.google.com/store/apps/details?id=com.prithveeshbhat.gpscamera" target="_blank" rel="noopener noreferrer">Get GPS Camera on Google Play <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`${base}apps/gps-camera/`}>Explore GPS Camera <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="product-feature__visual product-feature__visual--gps">
        <div class="product-feature__visual-glow" aria-hidden="true"></div>
        <div class="product-feature__device product-feature__device--gps"><div class="device-notch"></div><AppScreen app="gps" /></div>
        <div class="product-float-card product-float-card--gps"><span class="float-card-icon">⌖</span><span><b>LOCATION + CONTEXT</b><small>Details that stay with the capture.</small></span></div>
        <span class="product-feature__visual-caption">GPS CAMERA / FIELD DOCUMENTATION</span>
      </div>
    </article>
    <article class="product-feature product-feature--filtra" data-reveal>
      <div class="product-feature__copy">
        <div class="product-feature__meta"><span class="product-number">03</span><span class="eyebrow">NEXT IN THE PORTFOLIO</span><span class="availability availability--soon"><i></i> IN DEVELOPMENT</span></div>
        <h3>Something new<br /><em>is taking shape.</em></h3>
        <p class="product-feature__description">Meet Filtra, our upcoming application. We're shaping its experience with the same focus on purpose, clarity and thoughtful details.</p>
        <!-- FILTRA intentionally has no app-page link. -->
      </div>
      <div class="product-feature__visual product-feature__visual--filtra">
        <div class="product-feature__visual-glow" aria-hidden="true"></div>
        <div class="product-feature__device product-feature__device--filtra"><div class="device-notch"></div><AppScreen app="filtra" /></div>
        <span class="product-feature__visual-caption">FILTRA / COMING INTO FOCUS</span>
      </div>
    </article>
  </div>
</section>
