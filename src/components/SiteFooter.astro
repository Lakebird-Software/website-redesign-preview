---
import BrandMark from './BrandMark.astro';
import GooglePlayBadge from './GooglePlayBadge.astro';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer" id="footer" aria-label="Lakebird Software footer">
  <div class="container site-footer__inner">
    <div class="footer-main">
      <div class="footer-brand-block">
        <BrandMark />
        <a class="footer-email" href="mailto:support.pbandroidapps@gmail.com">support.pbandroidapps@gmail.com <span aria-hidden="true">↗</span></a>
        <GooglePlayBadge href="https://play.google.com/store/apps/details?id=com.prithveeshbhat.finly&amp;hl=en" label="Get FINLY on Google Play" />
      </div>
      <div class="footer-links-group">
        <div class="footer-column">
          <span class="eyebrow">EXPLORE</span>
          <a href={`${base}#top`}>Home</a>
          <a href={`${base}#applications`}>Applications</a>
          <a href={`${base}#studio`}>Our studio</a>
          <a href={`${base}#contact`}>Contact</a>
        </div>
        <div class="footer-column">
          <span class="eyebrow">APPLICATIONS</span>
          <a href={`${base}apps/finly/`}>Finly</a>
          <a href={`${base}apps/gps-camera/`}>GPS Camera</a>
          <a href={`${base}apps/filtra/`}>Filtra</a>
        </div>
        <div class="footer-column">
          <span class="eyebrow">PRIVACY</span>
          <a href={`${base}privacy/`}>Website privacy</a>
          <a href={`${base}privacy/finly/`}>Finly policy</a>
          <a href={`${base}privacy/gps-camera/`}>GPS Camera policy</a>
          <a href={`${base}privacy/filtra/`}>Filtra policy</a>
        </div>
      </div>
    </div>

    <div class="footer-wordmark-wrap" aria-hidden="true">
      <span class="footer-wordmark" data-text="LAKEBIRD SOFTWARE">LAKEBIRD SOFTWARE</span>
    </div>

    <div class="footer-bottom">
      <p>© 2026 Lakebird Software by Prithveesh Bhat. All rights reserved.</p>
      <span class="footer-bottom__tagline">Stay curious. Keep creating.</span>
      <a class="back-to-top" href={`${base}#top`}>Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
