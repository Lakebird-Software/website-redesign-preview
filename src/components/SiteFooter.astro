---
import BrandMark from './BrandMark.astro';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand-block">
        <BrandMark />
        <p>Thoughtful technology.<br />Extraordinary experiences.</p>
        <a class="footer-email" href="mailto:support.pbandroidapps@gmail.com">support.pbandroidapps@gmail.com <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-links-group">
        <div class="footer-column">
          <span class="eyebrow">EXPLORE</span>
          <a href={`${base}#applications`}>Applications</a>
          <a href={`${base}#studio`}>Our studio</a>
          <a href={`${base}#contact`}>Contact</a>
        </div>
        <div class="footer-column">
          <span class="eyebrow">APPLICATIONS</span>
          <a href={`${base}apps/finly/`}>Finly</a>
          <a href={`${base}apps/gps-camera/`}>GPS Camera</a>
          <a href={`${base}apps/filtra/`}>Filtra</a>
        </div>
        <div class="footer-column">
          <span class="eyebrow">PRIVACY</span>
          <a href={`${base}privacy/finly/`}>Finly policy</a>
          <a href={`${base}privacy/gps-camera/`}>GPS Camera policy</a>
          <a href={`${base}privacy/filtra/`}>Filtra policy</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Lakebird Software. All rights reserved.</p>
      <a href="https://play.google.com/store/apps/details?id=com.prithveeshbhat.finly&amp;hl=en" target="_blank" rel="noopener noreferrer">FINLY on Google Play <span aria-hidden="true">↗</span></a>
      <a class="back-to-top" href={`${base}#top`}>Back to top ↑</a>
    </div>
  </div>
</footer>
