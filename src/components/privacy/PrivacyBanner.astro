---
interface Props {
  appName: string;
  intro: string;
  updated: string;
  accent: 'finly' | 'gps-camera';
  highlights: string[];
  panelTitle: string;
  panelLines: string[];
}
const { appName, intro, updated, accent, highlights, panelTitle, panelLines } = Astro.props;
---
<header class="privacy-app-banner" data-app-accent={accent} aria-labelledby="privacy-app-title">
  <div class="privacy-app-banner__copy">
    <span class="eyebrow">LAKEBIRD SOFTWARE <span aria-hidden="true">/</span> APP PRIVACY</span>
    <p class="privacy-app-banner__product">{appName}</p>
    <h1 id="privacy-app-title">Privacy <em>Policy.</em></h1>
    <p class="privacy-app-banner__intro">{intro}</p>
    <div class="privacy-app-banner__tags" aria-label="Policy highlights">
      {highlights.map((highlight) => <span>{highlight}</span>)}
    </div>
    <div class="privacy-app-banner__meta">
      <span>LAST UPDATED · {updated}</span>
      <span>LAKEBIRD SOFTWARE · INDIA</span>
    </div>
  </div>
  <aside class="privacy-app-banner__panel" aria-label={panelTitle}>
    <span class="privacy-app-banner__panel-kicker">PRIVACY AT A GLANCE</span>
    <div class="privacy-app-banner__panel-mark" aria-hidden="true">
      {accent === 'finly' ? (
        <svg viewBox="0 0 64 64" fill="none"><path d="M32 5 53 13v16c0 14-8.8 23.8-21 30C19.8 52.8 11 43 11 29V13L32 5Z" stroke="currentColor" stroke-width="2.5"/><path d="m21 32 7 7 15-16" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      ) : (
        <svg viewBox="0 0 64 64" fill="none"><rect x="9" y="9" width="46" height="46" rx="12" stroke="currentColor" stroke-width="2.5"/><circle cx="32" cy="31" r="11" stroke="currentColor" stroke-width="2.5"/><path d="M32 5v8M32 51v8M5 32h8M51 32h8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      )}
    </div>
    <h2>{panelTitle}</h2>
    <ul>{panelLines.map((line) => <li>{line}</li>)}</ul>
    <span class="privacy-app-banner__panel-foot">CLEAR · PRACTICAL · TRANSPARENT</span>
  </aside>
</header>
