---
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Get it on Google Play' } = Astro.props;
---
<a class="google-play-badge" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
  <svg class="google-play-badge__icon" viewBox="30 336.7 120.9 129.2" aria-hidden="true" focusable="false">
    <path d="M119.2,421.2c15.3-8.4,27-14.8,28-15.3c3.2-1.7,6.5-6.2,0-9.7c-2.1-1.1-13.4-7.3-28-15.3l-20.1,20.2L119.2,421.2z" fill="#FFD400"></path>
    <path d="M99.1,401.1l-64.2,64.7c1.5,0.2,3.2-0.2,5.2-1.3c4.2-2.3,48.8-26.7,79.1-43.3L99.1,401.1L99.1,401.1z" fill="#FF3333"></path>
    <path d="M99.1,401.1l20.1-20.2c0,0-74.6-40.7-79.1-43.1c-1.7-1-3.6-1.3-5.3-1L99.1,401.1z" fill="#48FF48"></path>
    <path d="M99.1,401.1l-64.3-64.3c-2.6,0.6-4.8,2.9-4.8,7.6c0,7.5,0,107.5,0,113.8c0,4.3,1.7,7.4,4.9,7.7L99.1,401.1z" fill="#3BCCFF"></path>
  </svg>
  <span class="google-play-badge__copy">
    <span class="google-play-badge__eyebrow">GET IT ON</span>
    <span class="google-play-badge__title">Google Play</span>
  </span>
</a>
