---
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Get it on Google Play' } = Astro.props;
---
<a class="google-play-badge" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
  <img
    src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
    alt="Get it on Google Play"
    loading="lazy"
    decoding="async"
  />
</a>
