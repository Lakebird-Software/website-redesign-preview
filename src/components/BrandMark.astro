---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class:list={["brand", compact && "brand--compact"]} href={base} aria-label="Lakebird Software home">
  <span class="brand__symbol" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none">
      <path d="M7 27.5C13.2 15.9 24.4 9.4 39.5 9.3C34.9 16.2 28.2 20.8 19.2 23.1C28.4 22.6 35.7 25.3 41 31.2C29.2 38.8 17.8 38.7 7 27.5Z" fill="currentColor" fill-opacity=".17" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M7 27.5C15.3 27 23.1 23.4 30.4 16.7M13.1 32.5C21 31.1 27.2 28.6 32 25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="37.2" cy="12" r="2.2" fill="#75E6D2"/>
    </svg>
  </span>
  <span class="brand__wordmark">
    <span class="brand__name">LAKEBIRD</span>
    <span class="brand__descriptor">SOFTWARE</span>
  </span>
</a>
