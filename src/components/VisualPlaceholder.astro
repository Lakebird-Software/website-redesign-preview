---
interface Props {
  label: string;
  hint?: string;
  class?: string;
  variant?: 'aqua' | 'indigo' | 'photo' | 'neutral';
}
const { label, hint = 'Replace with your original app screenshot', class: className = '', variant = 'aqua' } = Astro.props;
---
<div class:list={['visual-placeholder', `visual-placeholder--${variant}`, className]} role="img" aria-label={`${label}. ${hint}. Image placeholder.`}>
  <div class="placeholder-orbit placeholder-orbit--one"></div>
  <div class="placeholder-orbit placeholder-orbit--two"></div>
  <div class="placeholder-core">
    <span class="placeholder-kicker">IMAGE PLACEHOLDER</span>
    <span class="placeholder-title">{label}</span>
    <span class="placeholder-hint">{hint}</span>
  </div>
  <span class="placeholder-corner placeholder-corner--tl"></span>
  <span class="placeholder-corner placeholder-corner--br"></span>
</div>
