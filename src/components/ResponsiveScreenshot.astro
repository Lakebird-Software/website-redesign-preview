---
interface Props {
  src: string;
  alt: string;
  kind?: 'phone' | 'tablet' | 'landscape' | 'square' | 'photo';
  class?: string;
  loading?: 'eager' | 'lazy';
}
const {
  src,
  alt,
  kind = 'phone',
  class: className = '',
  loading = 'lazy',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const imagePath = src.replace(/^\/+/, '');
const imageSrc = /^https?:\/\//i.test(src) ? src : `${base}${imagePath}`;
---
<div class:list={['screenshot-frame', `screenshot-frame--${kind}`, className]}>
  <img
    src={imageSrc}
    alt={alt}
    loading={loading}
    decoding="async"
    draggable="false"
  />
</div>
