---
import BaseLayout from '../../layouts/BaseLayout.astro';
const policies = [
  { slug: 'finly', name: 'FINLY' },
  { slug: 'gps-camera', name: 'GPS CAMERA' },
  { slug: 'filtra', name: 'FILTRA' },
];
export function getStaticPaths() {
  return policies.map((policy) => ({ params: { app: policy.slug }, props: { policy } }));
}
const { policy } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${policy.name} Privacy Policy — Lakebird Software`} description={`Privacy information for ${policy.name}.`} canonicalPath={`/privacy/${policy.slug}/`}>
  <section class="placeholder-page section-pad">
    <div class="container placeholder-page__inner">
      <span class="eyebrow">LAKEBIRD SOFTWARE / PRIVACY</span>
      <h1>{policy.name}</h1>
      <h2>Official policy content must be added before launch</h2>
      <p>This is a temporary route only. The approved, current privacy policy for {policy.name} must be inserted here before this page is published or linked as the app's official policy.</p>
      <p class="placeholder-page__notice">Do not treat this placeholder as a privacy policy. Replace it with the exact policy text or link to the approved hosted policy before launch.</p>
      <a class="text-link" href={base}>← Back to Lakebird Software</a>
    </div>
  </section>
</BaseLayout>
