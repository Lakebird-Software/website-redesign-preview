---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinlyPrivacy from '../../components/privacy/FinlyPrivacy.astro';
import GpsCameraPrivacy from '../../components/privacy/GpsCameraPrivacy.astro';

export function getStaticPaths() {
  const policies = [
    { slug: 'finly', name: 'FINLY', description: 'FINLY privacy policy — local-first personal finance records and optional Google Drive backup.' },
    { slug: 'gps-camera', name: 'GPS Camera', description: 'GPS Camera privacy policy — local photo and location storage, device permissions and Google AdMob advertising.' },
    { slug: 'filtra', name: 'FILTRA', description: 'Filtra privacy policy placeholder. The policy will be added when the app details are finalized.' }
  ];
  return policies.map((policy) => ({ params: { app: policy.slug }, props: { policy } }));
}

const { policy } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${policy.name} Privacy Policy — Lakebird Software`} description={policy.description} canonicalPath={`/privacy/${policy.slug}/`}>
  {policy.slug === 'finly' ? (
    <FinlyPrivacy />
  ) : policy.slug === 'gps-camera' ? (
    <GpsCameraPrivacy />
  ) : (
    <section class="placeholder-page section-pad">
      <div class="container placeholder-page__inner">
        <span class="eyebrow">LAKEBIRD SOFTWARE / APP PRIVACY</span>
        <h1>FILTRA</h1>
        <h2>Privacy policy in preparation</h2>
        <p>The Filtra privacy policy will be prepared when the app's data practices and release details are finalized.</p>
        <p class="placeholder-page__notice">This is a temporary page and is not an official Filtra privacy policy.</p>
        <a class="text-link" href={`${base}privacy/`}>Read the Lakebird Software website privacy policy</a>
        <a class="text-link" href={base}>← Back to Lakebird Software</a>
      </div>
    </section>
  )}
</BaseLayout>
