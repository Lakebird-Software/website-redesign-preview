---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const policies = [
    { slug: 'finly', name: 'FINLY' },
    { slug: 'gps-camera', name: 'GPS CAMERA' },
    { slug: 'filtra', name: 'FILTRA' }
  ];
  return policies.map((policy) => ({ params: { app: policy.slug }, props: { policy } }));
}

const { policy } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${policy.name} Privacy Policy — Lakebird Software`} description={`App-specific privacy information for ${policy.name}.`} canonicalPath={`/privacy/${policy.slug}/`}>
  <section class="placeholder-page section-pad">
    <div class="container placeholder-page__inner">
      <span class="eyebrow">LAKEBIRD SOFTWARE / APP PRIVACY</span>
      <h1>{policy.name}</h1>
      <h2>App-specific privacy information</h2>
      <p>This is a temporary page route. The approved privacy policy for {policy.name} must be added here before this page is used as the app's official privacy-policy URL.</p>
      <p class="placeholder-page__notice">This page is not yet the app's legal privacy policy. Please use the current policy linked from the relevant Google Play listing until the dedicated page is approved and published.</p>
      <a class="text-link" href={`${base}privacy/`}>Read the Lakebird Software website privacy policy</a>
      <a class="text-link" href={base}>← Back to Lakebird Software</a>
    </div>
  </section>
</BaseLayout>
