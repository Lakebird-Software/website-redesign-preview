---
import BaseLayout from '../layouts/BaseLayout.astro';

// Explicit GitHub Pages project path for the preview repository.
const media = '/website-redesign-preview/gps-camera-assets/';
const playUrl = 'https://play.google.com/store/apps/details?id=com.prithveeshbhat.gpscamera';
const title = 'GPS Camera: Geo Tagging — Capture the moment. Keep its place.';
const description = 'Capture photos and videos with GPS location, maps, date and time stamps. Organise projects, customise your overlays and create professional PDF reports with GPS Camera by Lakebird Software.';
---

<BaseLayout title={title} description={description} canonicalPath="/gps-camera-B/">
  <div class="gps-page" id="top">
    <section class="gps-hero" aria-labelledby="gps-hero-title">
      <div class="gps-hero__glow gps-hero__glow--one" aria-hidden="true"></div>
      <div class="gps-hero__glow gps-hero__glow--two" aria-hidden="true"></div>
      <div class="gps-wrap gps-hero__grid">
        <div class="gps-hero__copy" data-reveal>
          <div class="gps-eyebrow"><span class="gps-eyebrow__dot"></span> GPS CAMERA <span class="gps-eyebrow__slash">/</span> GEO TAGGING</div>
          <h1 id="gps-hero-title">Capture the moment.<br /><span>Keep its place.</span></h1>
          <p class="gps-hero__intro">Give every photo and video a little more context. Add location, map, date and time details as you capture — then keep your media organised for the moments and work that matter.</p>
          <div class="gps-hero__actions">
            <a class="gps-button gps-button--primary" href={playUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.2 2.8c-.4.4-.7 1-.7 1.8v14.8c0 .8.3 1.4.7 1.8L13 12 4.2 2.8Z"/><path fill="currentColor" opacity=".78" d="m14.2 13.2-2.4 2.5-5.5 5.7c.6.4 1.4.4 2.2 0l8.3-4.8-2.6-3.4Z"/><path fill="currentColor" opacity=".9" d="m16.8 7.4-8.3-4.8c-.8-.4-1.6-.4-2.2 0l5.5 5.7 2.4 2.5 2.6-3.4Z"/><path fill="currentColor" opacity=".65" d="m19.3 10.9-2.5-1.5-2.6 3.4 2.6 3.4 2.5-1.5c1.7-1 1.7-2.8 0-3.8Z"/></svg>
              <span><small>GET IT ON</small>Google Play</span>
              <span class="gps-button__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="gps-text-link" href="#experience">Explore the experience <span aria-hidden="true">↓</span></a>
          </div>
          <div class="gps-hero__signature">
            <span class="gps-hero__mini-logo"><img src={`${media}gps-camera-logo-map.webp`} alt="" /></span>
            <span><strong>Capture. Tag. Remember.</strong><small>Useful details, right where you need them.</small></span>
          </div>
        </div>

        <div class="gps-hero__visual" data-reveal data-reveal-delay="140">
          <div class="gps-hero__halo" aria-hidden="true"></div>
          <div class="gps-hero__orbit gps-hero__orbit--a" aria-hidden="true"></div>
          <div class="gps-hero__orbit gps-hero__orbit--b" aria-hidden="true"></div>
          <div class="gps-hero__poster">
            <img src={`${media}camera-screen-promotional.webp`} alt="GPS Camera app preview showing a live camera view with a map and location details on screen" fetchpriority="high" />
          </div>
          <div class="gps-float-card gps-float-card--location">
            <span class="gps-float-icon gps-float-icon--pin" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 10.2c0 5.1-7 11.1-7 11.1S5 15.3 5 10.2a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.2"/></svg></span>
            <span><small>LOCATION STAMP</small><strong>Place. Coordinates. Time.</strong></span>
          </div>
          <div class="gps-float-card gps-float-card--video">
            <span class="gps-record-dot" aria-hidden="true"></span>
            <span><small>VIDEO MODE</small><strong>GPS details in motion</strong></span>
          </div>
          <div class="gps-hero__caption"><span class="gps-caption-line"></span> A camera experience with context built in</div>
        </div>
      </div>
      <div class="gps-hero__bottom gps-wrap" aria-hidden="true">
        <span>PHOTOS</span><i></i><span>VIDEOS</span><i></i><span>PROJECTS</span><i></i><span>REPORTS</span>
      </div>
    </section>

    <section class="gps-intro-band" id="experience" aria-label="GPS Camera overview">
      <div class="gps-wrap gps-intro-band__inner">
        <p>More than a camera.</p>
        <h2>A record of <em>where</em> and <em>when.</em></h2>
        <span>Location-rich captures, organised into a workflow you can return to.</span>
      </div>
    </section>

    <section class="gps-capture gps-section" aria-labelledby="gps-capture-title">
      <div class="gps-wrap">
        <div class="gps-section-heading gps-section-heading--split" data-reveal>
          <div>
            <span class="gps-section-kicker">01 / CAPTURE WITH CONTEXT</span>
            <h2 id="gps-capture-title">Let the details<br /><em>travel with the image.</em></h2>
          </div>
          <p>Add useful place and time information to your photographs and videos as you capture. Keep the context visible, not buried in a separate note.</p>
        </div>
        <div class="gps-capture-grid">
          <article class="gps-media-card gps-media-card--photo" data-reveal>
            <div class="gps-media-card__image"><img src={`${media}playstore-01-location-photos-videos.webp`} alt="GPS Camera photograph with a location label, address, coordinates and capture date and time" loading="lazy" /></div>
            <div class="gps-media-card__copy">
              <span class="gps-card-index">01 — PHOTOGRAPHY</span>
              <h3>Photos with a sense of place.</h3>
              <p>Stamp photographs with location details, maps, coordinates, date and time. Add custom notes when the moment needs a little more explanation.</p>
            </div>
          </article>
          <article class="gps-media-card gps-media-card--video" data-reveal data-reveal-delay="100">
            <div class="gps-media-card__image"><img src={`${media}playstore-08-geotagged-video.webp`} alt="GPS Camera video recording preview with live location information overlaid on the footage" loading="lazy" /></div>
            <div class="gps-media-card__copy">
              <span class="gps-card-index">02 — VIDEO</span>
              <h3>Keep the context in motion.</h3>
              <p>Record video with GPS information displayed directly in the footage, so the location details stay with the scene you are documenting.</p>
            </div>
          </article>
        </div>
        <div class="gps-capture__detail-row" data-reveal>
          <span class="gps-detail-chip"><b>⌖</b> Address & place</span>
          <span class="gps-detail-chip"><b>＋</b> Latitude & longitude</span>
          <span class="gps-detail-chip"><b>◷</b> Date & time</span>
          <span class="gps-detail-chip"><b>▦</b> Map details</span>
          <span class="gps-detail-chip"><b>✎</b> Custom notes</span>
        </div>
      </div>
    </section>

    <section class="gps-camera-section gps-section" aria-labelledby="gps-camera-title">
      <div class="gps-wrap gps-camera-layout">
        <div class="gps-camera-copy">
          <div class="gps-section-heading" data-reveal>
            <span class="gps-section-kicker">02 / THE CAMERA EXPERIENCE</span>
            <h2 id="gps-camera-title">Ready when<br /><em>the moment happens.</em></h2>
            <p>Thoughtful camera controls help you frame the scene, focus on the detail and capture without getting in the way.</p>
          </div>
          <div class="gps-camera-features" role="group" aria-label="Explore camera features">
            <button class="gps-camera-feature is-active" type="button" data-camera-feature data-shot={`${media}playstore-03-pro-camera-maps.webp`}>
              <span class="gps-feature-number">01</span><div><h3>Fast, responsive capture</h3><p>Zero-shutter-lag capture helps you take the shot when the moment is there.</p></div><span class="gps-feature-chevron">↗</span>
            </button>
            <button class="gps-camera-feature" type="button" data-camera-feature data-shot={`${media}playstore-05-custom-notes-and-coordinates.webp`}>
              <span class="gps-feature-number">02</span><div><h3>Focus on the subject</h3><p>Use autofocus and tap-to-focus to bring the important detail into view.</p></div><span class="gps-feature-chevron">↗</span>
            </button>
            <button class="gps-camera-feature" type="button" data-camera-feature data-shot={`${media}playstore-03-pro-camera-maps.webp`}>
              <span class="gps-feature-number">03</span><div><h3>Choose your framing</h3><p>Quick 0.5×, 1× and 2× zoom presets make it easy to move between views.</p></div><span class="gps-feature-chevron">↗</span>
            </button>
            <button class="gps-camera-feature" type="button" data-camera-feature data-shot={`${media}playstore-01-location-photos-videos.webp`}>
              <span class="gps-feature-number">04</span><div><h3>See the map before the shot</h3><p>Live street-map rendering, continuous torch mode and adjustable stamp text size add control when conditions change.</p></div><span class="gps-feature-chevron">↗</span>
            </button>
          </div>
        </div>
        <div class="gps-camera-visual" data-reveal data-reveal-delay="120">
          <div class="gps-camera-visual__frame">
            <div class="gps-camera-visual__top"><span>CAMERA / LIVE VIEW</span><span class="gps-camera-visual__indicator"><i></i> READY</span></div>
            <img id="gps-camera-feature-image" src={`${media}playstore-03-pro-camera-maps.webp`} alt="GPS Camera professional camera screen with a live street map and zoom controls" loading="lazy" />
            <div class="gps-camera-visual__foot"><span>0.5×</span><b>1×</b><span>2×</span><i></i><span class="gps-camera-visual__foot-note">Tap a feature to explore</span></div>
          </div>
          <div class="gps-camera-visual__orb" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="gps-edit-section gps-section" aria-labelledby="gps-edit-title">
      <div class="gps-wrap gps-edit-layout">
        <div class="gps-edit-visual" data-reveal>
          <div class="gps-edit-visual__glow" aria-hidden="true"></div>
          <img src={`${media}playstore-05-custom-notes-and-coordinates.webp`} alt="GPS Camera photo stamp showing a location, coordinates and custom note" loading="lazy" />
          <div class="gps-edit-visual__label"><span class="gps-edit-pulse"></span> DETAILS THAT MATTER</div>
        </div>
        <div class="gps-edit-copy" data-reveal data-reveal-delay="100">
          <span class="gps-section-kicker">03 / AFTER THE CAPTURE</span>
          <h2 id="gps-edit-title">The moment has passed.<br /><em>The details can still be refined.</em></h2>
          <p>Already taken the photograph? Bring an existing image into the in-app editor and add or adjust its GPS and time information afterwards.</p>
          <ul class="gps-check-list">
            <li><span>✓</span> Apply location and time stamps to existing gallery photos</li>
            <li><span>✓</span> Edit the displayed address</li>
            <li><span>✓</span> Reposition the information label</li>
            <li><span>✓</span> Add custom notes to provide more context</li>
          </ul>
          <p class="gps-edit-copy__note">Your capture workflow does not have to end when you press the shutter.</p>
        </div>
      </div>
    </section>

    <section class="gps-templates gps-section" aria-labelledby="gps-templates-title">
      <div class="gps-wrap">
        <div class="gps-section-heading gps-section-heading--center" data-reveal>
          <span class="gps-section-kicker">04 / STAMP STYLES</span>
          <h2 id="gps-templates-title">Your details.<br /><em>Your kind of layout.</em></h2>
          <p>Choose a stamp style that suits the way you use your camera — from everyday memories to more structured field documentation.</p>
        </div>
        <div class="gps-template-explorer" data-reveal>
          <div class="gps-template-options" role="group" aria-label="Explore GPS stamp template styles">
            <button class="gps-template-option is-selected" type="button" data-template="classic" aria-pressed="true"><span class="gps-template-option__num">01</span><span><strong>Classic & Compact</strong><small>Clean, essential information</small></span><span class="gps-template-option__arrow">↗</span></button>
            <button class="gps-template-option" type="button" data-template="corporate" aria-pressed="false"><span class="gps-template-option__num">02</span><span><strong>Corporate & Professional</strong><small>Clear, business-ready layouts</small></span><span class="gps-template-option__arrow">↗</span></button>
            <button class="gps-template-option" type="button" data-template="adventure" aria-pressed="false"><span class="gps-template-option__num">03</span><span><strong>Adventure & Travel</strong><small>Made for the journey</small></span><span class="gps-template-option__arrow">↗</span></button>
            <button class="gps-template-option" type="button" data-template="engineering" aria-pressed="false"><span class="gps-template-option__num">04</span><span><strong>Engineering & Journal</strong><small>More room for field details</small></span><span class="gps-template-option__arrow">↗</span></button>
          </div>
          <div class="gps-template-stage" data-template-stage="classic" aria-live="polite">
            <div class="gps-template-stage__top"><span>STAMP STYLE PREVIEW</span><span class="gps-template-stage__live"><i></i> INTERACTIVE EXAMPLE</span></div>
            <div class="gps-template-preview" id="gps-template-preview">
              <div class="gps-template-preview__map"><span class="gps-map-road gps-map-road--one"></span><span class="gps-map-road gps-map-road--two"></span><span class="gps-map-road gps-map-road--three"></span><span class="gps-map-pin">⌖</span></div>
              <div class="gps-template-preview__stamp">
                <span class="gps-template-preview__category">GPS CAMERA / CLASSIC</span>
                <strong id="gps-template-name">Location captured</strong>
                <span id="gps-template-place">Address · coordinates</span>
                <div class="gps-template-preview__meta"><span>DATE & TIME</span><b>LOCATION DETAILS</b></div>
              </div>
            </div>
            <p class="gps-template-stage__note">Illustrative preview of the template families listed for GPS Camera; it is not an additional in-app screen.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="gps-workflow gps-section" aria-labelledby="gps-workflow-title">
      <div class="gps-wrap">
        <div class="gps-section-heading gps-section-heading--split" data-reveal>
          <div><span class="gps-section-kicker">05 / PROJECTS & REPORTS</span><h2 id="gps-workflow-title">From field captures<br /><em>to organised reports.</em></h2></div>
          <p>Keep work, visits and trips together. When it is time to share the record, bring selected captures into a polished PDF report.</p>
        </div>
        <div class="gps-workflow-grid">
          <article class="gps-work-card gps-work-card--folders" data-reveal>
            <div class="gps-work-card__image"><img src={`${media}playstore-02-project-folders.webp`} alt="GPS Camera albums screen with separate custom project folders" loading="lazy" /></div>
            <div class="gps-work-card__body"><span class="gps-card-index">01 — ORGANISE</span><h3>Give every project its place.</h3><p>Create custom folders for different jobs, sites or journeys. Keep related photographs and videos easy to find and manage.</p></div>
          </article>
          <article class="gps-work-card gps-work-card--history" data-reveal data-reveal-delay="80">
            <div class="gps-work-card__image gps-work-card__image--contain"><img src={`${media}playstore-07-capture-history-statistics.webp`} alt="GPS Camera profile and statistics screen showing photo, video and storage counts" loading="lazy" /></div>
            <div class="gps-work-card__body"><span class="gps-card-index">02 — LOOK BACK</span><h3>Track your capture history.</h3><p>Return to your capture activity through the profile and statistics view, with an overview of your photos, videos and storage.</p></div>
          </article>
          <article class="gps-work-card gps-work-card--reports" data-reveal data-reveal-delay="160">
            <div class="gps-work-card__image"><img src={`${media}playstore-04-pdf-reports.webp`} alt="GPS Camera preview of an A4 PDF report with a business logo and geotagged photographs" loading="lazy" /></div>
            <div class="gps-work-card__body"><span class="gps-card-index">03 — SHARE THE RECORD</span><h3>Make a report that is ready to present.</h3><p>Select photographs and generate an A4 PDF report with your business logo, capture dates and GPS coordinates.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="gps-usecases gps-section" aria-labelledby="gps-usecases-title">
      <div class="gps-wrap gps-usecases__layout">
        <div class="gps-usecases__intro" data-reveal>
          <span class="gps-section-kicker">06 / MADE FOR REAL-WORLD WORK</span>
          <h2 id="gps-usecases-title">Made for the field.<br /><em>Ready for the journey.</em></h2>
          <p>Wherever a photograph needs more than a picture, GPS Camera helps keep the place and time in view.</p>
        </div>
        <div class="gps-usecase-grid" data-reveal data-reveal-delay="100">
          <article class="gps-usecase"><span class="gps-usecase__icon"><svg viewBox="0 0 24 24"><path d="M3 20.5h18M5 20V8.5l7-4 7 4V20M9 20v-6h6v6M8 9.5h.01M12 9.5h.01M16 9.5h.01"/></svg></span><h3>Construction & engineering</h3><p>Document site progress and field work with location-rich captures and project folders.</p><span class="gps-usecase__index">01</span></article>
          <article class="gps-usecase"><span class="gps-usecase__icon"><svg viewBox="0 0 24 24"><path d="M3 20.5h18M5 20V5h14v15M8 8h3v3H8zM14 8h3v3h-3zM8 14h3v3H8zM14 14h3v6h-3z"/></svg></span><h3>Real estate & architecture</h3><p>Keep property visits and visual documentation connected to their locations.</p><span class="gps-usecase__index">02</span></article>
          <article class="gps-usecase"><span class="gps-usecase__icon"><svg viewBox="0 0 24 24"><path d="M4 4.5h16v15H4zM8 8.5h8M8 12h8M8 15.5h4M16.5 16l1.5 1.5 3-3"/></svg></span><h3>Surveyors & inspectors</h3><p>Capture field observations with coordinates, timestamps and notes for later review.</p><span class="gps-usecase__index">03</span></article>
          <article class="gps-usecase"><span class="gps-usecase__icon"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.3"/><path d="M3 21h18"/></svg></span><h3>Travel & exploration</h3><p>Keep the where and when attached to the memories you bring back.</p><span class="gps-usecase__index">04</span></article>
        </div>
      </div>
    </section>

    <section class="gps-control-note gps-section" aria-labelledby="gps-control-title">
      <div class="gps-wrap gps-control-note__panel" data-reveal>
        <div class="gps-control-note__symbol"><img src={`${media}gps-camera-logo-transparent.webp`} alt="GPS Camera logo" loading="lazy" /></div>
        <div class="gps-control-note__copy"><span class="gps-section-kicker">07 / YOUR CAPTURE WORKFLOW</span><h2 id="gps-control-title">Useful information.<br /><em>When you need it.</em></h2><p>Use location-aware camera features, review your captures, organise them into projects and create reports as your workflow calls for them. Location and camera features rely on the permissions and device settings you choose.</p><p class="gps-ad-note"><span class="gps-ad-note__dot"></span> GPS Camera is supported by ads. <a href={playUrl} target="_blank" rel="noopener noreferrer">See the app on Google Play <span aria-hidden="true">↗</span></a></p></div>
      </div>
    </section>

    <section class="gps-faq gps-section" aria-labelledby="gps-faq-title">
      <div class="gps-wrap gps-faq__layout">
        <div class="gps-section-heading" data-reveal><span class="gps-section-kicker">08 / GOOD TO KNOW</span><h2 id="gps-faq-title">A few things<br /><em>you might be wondering.</em></h2><p>Some quick answers about what GPS Camera can help you do.</p></div>
        <div class="gps-faq-list" data-reveal data-reveal-delay="100">
          <details class="gps-faq-item" open><summary>What information can GPS Camera add to a photo?<span></span></summary><p>Depending on the selected stamp layout and available device location, you can include address, map details, latitude and longitude, date, time and custom notes.</p></details>
          <details class="gps-faq-item"><summary>Can I record videos with GPS information?<span></span></summary><p>Yes. GPS Camera supports video recording with live GPS details displayed in the footage.</p></details>
          <details class="gps-faq-item"><summary>Can I add GPS details to a photo I already took?<span></span></summary><p>Yes. Use the in-app photo editor to apply GPS and time stamps to existing gallery photos, edit the displayed address and reposition the label.</p></details>
          <details class="gps-faq-item"><summary>Can I organise captures by project?<span></span></summary><p>Yes. Create custom folders for different projects, sites or trips to keep related media together.</p></details>
          <details class="gps-faq-item"><summary>Can I create reports for work?<span></span></summary><p>Yes. Select photos to generate an A4 PDF report with your business logo, dates and GPS coordinates.</p></details>
          <details class="gps-faq-item"><summary>Does GPS Camera display ads?<span></span></summary><p>Yes. GPS Camera contains ads. The Google Play listing provides the latest app details and data-safety information.</p></details>
        </div>
      </div>
    </section>

    <section class="gps-final-cta" aria-labelledby="gps-final-title">
      <div class="gps-final-cta__glow" aria-hidden="true"></div>
      <div class="gps-wrap gps-final-cta__inner" data-reveal>
        <div class="gps-final-cta__logo"><img src={`${media}gps-camera-logo-transparent.webp`} alt="GPS Camera" loading="lazy" /></div>
        <span class="gps-section-kicker">GPS CAMERA / GEO TAGGING</span>
        <h2 id="gps-final-title">Make every<br /><em>capture count.</em></h2>
        <p>Record the moment. Keep the place. Bring your photos, videos and field records together with GPS Camera.</p>
        <a class="gps-button gps-button--primary gps-button--final" href={playUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.2 2.8c-.4.4-.7 1-.7 1.8v14.8c0 .8.3 1.4.7 1.8L13 12 4.2 2.8Z"/><path fill="currentColor" opacity=".78" d="m14.2 13.2-2.4 2.5-5.5 5.7c.6.4 1.4.4 2.2 0l8.3-4.8-2.6-3.4Z"/><path fill="currentColor" opacity=".9" d="m16.8 7.4-8.3-4.8c-.8-.4-1.6-.4-2.2 0l5.5 5.7 2.4 2.5 2.6-3.4Z"/><path fill="currentColor" opacity=".65" d="m19.3 10.9-2.5-1.5-2.6 3.4 2.6 3.4 2.5-1.5c1.7-1 1.7-2.8 0-3.8Z"/></svg>
          <span><small>DOWNLOAD ON</small>Google Play</span><span class="gps-button__arrow" aria-hidden="true">↗</span>
        </a>
        <span class="gps-final-cta__footnote">Available on Google Play · Contains ads</span>
      </div>
    </section>
  </div>

  <script is:inline>
    // This dedicated app page keeps its dark GPS Camera identity regardless of a saved site theme.
    document.documentElement.dataset.theme = 'dark';
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.site-footer .back-to-top').forEach((link) => link.setAttribute('href', '#top'));
    });
  </script>

  <script>
    document.documentElement.classList.add('gps-js');
    const revealItems = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-revealed'));
    }

    const cameraFeatureItems = [...document.querySelectorAll('[data-camera-feature]')];
    const cameraImage = document.getElementById('gps-camera-feature-image');
    cameraFeatureItems.forEach((item) => {
      item.addEventListener('click', () => {
        cameraFeatureItems.forEach((feature) => feature.classList.remove('is-active'));
        item.classList.add('is-active');
        if (cameraImage && item.dataset.shot) {
          cameraImage.classList.add('is-changing');
          window.setTimeout(() => {
            cameraImage.src = item.dataset.shot;
            cameraImage.classList.remove('is-changing');
          }, 160);
        }
      });
    });

    const templateContent = {
      classic: { name: 'Location captured', place: 'Address · coordinates', category: 'GPS CAMERA / CLASSIC' },
      corporate: { name: 'Site documentation', place: 'Project · address · timestamp', category: 'GPS CAMERA / PROFESSIONAL' },
      adventure: { name: 'A place worth remembering', place: 'Destination · date · time', category: 'GPS CAMERA / TRAVEL' },
      engineering: { name: 'Field record', place: 'Coordinates · notes · timestamp', category: 'GPS CAMERA / FIELD JOURNAL' }
    };
    const templateButtons = [...document.querySelectorAll('[data-template]')];
    const templateStage = document.querySelector('[data-template-stage]');
    const templateName = document.getElementById('gps-template-name');
    const templatePlace = document.getElementById('gps-template-place');
    const templateCategory = document.querySelector('.gps-template-preview__category');
    templateButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.template;
        const details = templateContent[key];
        if (!details) return;
        templateButtons.forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        if (templateStage) templateStage.dataset.templateStage = key;
        if (templateName) templateName.textContent = details.name;
        if (templatePlace) templatePlace.textContent = details.place;
        if (templateCategory) templateCategory.textContent = details.category;
      });
    });

    const faqItems = [...document.querySelectorAll('.gps-faq-item')];
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) faqItems.filter((other) => other !== item).forEach((other) => { other.open = false; });
      });
    });
  </script>
</BaseLayout>

