---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinlyPage from '../../components/finly/FinlyPage.astro';
export function getStaticPaths() {
  const pages = [
    {
      slug: 'filtra',
      name: 'FILTRA',
      descriptor: 'Something new is taking shape.',
      status: 'In development',
      message: 'The dedicated Filtra product page will be added when its product story and approved feature details are ready.'
    }
  ];
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const statusClass =
  page.status === 'In development'
    ? 'availability availability--soon'
    : 'availability availability--live';
const description =
  page.slug === 'finly'
    ? 'Finly makes everyday money management simpler. Organise income, expenses, budgets and financial records without an account or login.'
    : page.descriptor;
---
<BaseLayout
  title={`${page.name} — Lakebird Software`}
  description={description}
  canonicalPath={`/apps/${page.slug}/`}
  forceDarkTheme={page.slug === 'finly'}
>
  {
    page.slug === 'finly' ? (
      <FinlyPage />
    ) : (
      <section class="placeholder-page section-pad">
        <div class="container placeholder-page__inner">
          <span class="eyebrow">LAKEBIRD SOFTWARE / APPLICATION</span>
          <span class={statusClass}>{page.status}</span>
          <h1>{page.name}</h1>
          <h2>{page.descriptor}</h2>
          <p>{page.message}</p>
          {page.play && (
            <a
              class="text-link"
              href={page.play}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on Google Play <span aria-hidden="true">↗</span>
            </a>
          )}
          <a class="text-link" href={`${base}#applications`}>
            ← Back to all applications
          </a>
          <p class="placeholder-page__notice">
            This is a temporary route so the homepage links work.
            The full product page will replace this placeholder during
            the next design stage.
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
