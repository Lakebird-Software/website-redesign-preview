  @keyframes gps-folder-back { 0%,100% { transform: translate(-24px,-24px) rotate(-10deg); } 50% { transform: translate(-29px,-29px) rotate(-12deg); } }
  @keyframes gps-folder-middle { 0%,100% { transform: translate(19px,-12px) rotate(8deg); } 50% { transform: translate(24px,-17px) rotate(10deg); } }
  @keyframes gps-folder-front { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
