  .gps-final-cta { position: relative; overflow: hidden; padding: 112px 0 120px; border-top: 1px solid rgba(187,134,252,.13); background: radial-gradient(ellipse at 50% 10%, rgba(98,0,234,.22), transparent 44%), linear-gradient(180deg, #1a1722, #121212 85%); text-align: center; isolation: isolate; }
