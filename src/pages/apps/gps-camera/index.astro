  [data-reveal] { opacity: 1; transform: none; }
  :global(html.gps-js) [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .75s ease, transform .75s var(--gps-ease); }
  :global(html.gps-js) [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }
  :global(html.gps-js) [data-reveal-delay='80'] { transition-delay: .08s; }
  :global(html.gps-js) [data-reveal-delay='100'] { transition-delay: .1s; }
  :global(html.gps-js) [data-reveal-delay='120'] { transition-delay: .12s; }
  :global(html.gps-js) [data-reveal-delay='140'] { transition-delay: .14s; }
  :global(html.gps-js) [data-reveal-delay='160'] { transition-delay: .16s; }
  /* Give headings and reading text more breathing room across the whole page. */
  .gps-page { letter-spacing: .01em; word-spacing: .025em; }
  .gps-page p, .gps-page li { letter-spacing: .012em; word-spacing: .04em; }
  .gps-page h1, .gps-page h2, .gps-page h3 { letter-spacing: -.022em; word-spacing: .015em; }
  .gps-hero h1 { letter-spacing: -.025em; }
  .gps-intro-band h2 { letter-spacing: -.02em; }
  .gps-section-heading h2, .gps-edit-copy h2, .gps-usecases__intro h2, .gps-control-note h2, .gps-faq h2 { letter-spacing: -.025em; }
  .gps-media-card h3, .gps-work-card h3 { letter-spacing: -.012em; }
  .gps-camera-feature h3, .gps-usecase h3 { letter-spacing: -.01em; }
  .gps-final-cta h2 { letter-spacing: -.025em; }
  .gps-page button, .gps-page a { letter-spacing: .008em; }
  .gps-page button:focus-visible, .gps-page a:focus-visible, .gps-page summary:focus-visible { outline: 2px solid #D8B7FF; outline-offset: 4px; }
  @keyframes gps-float { 0%,100% { transform: translateY(0) rotate(2.3deg); } 50% { transform: translateY(-13px) rotate(1deg); } }
