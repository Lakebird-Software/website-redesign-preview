  .gps-usecase-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
  .gps-usecase { position: relative; min-height: 230px; padding: 26px 22px; overflow: hidden; border: 1px solid var(--gps-border); border-radius: 18px; background: rgba(30,30,46,.58); transition: background .25s ease, border-color .25s ease, transform .25s ease; }
