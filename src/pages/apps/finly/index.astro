---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const playUrl = 'https://play.google.com/store/apps/details?id=com.prithveeshbhat.finly&hl=en';
const finlyLogoUrl = 'https://play-lh.googleusercontent.com/FLUJjiYrZX8m3xpjAPgSGzc-vU6p6yF4tmamA467q7fUZh3PBaOzX0npMDVNTgIJQE5fWJ4He-H18UbA8-4-vA=w240-h480-rw';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const privacyUrl = `${base}privacy/finly/`;
---

<BaseLayout
  title="FINLY — A clearer view of your money | Lakebird Software"
  description="Organise income, expenses, budgets and financial records with Finly. No account or login required. Offline-first, ad-free personal finance management."
  canonicalPath="/apps/finly/"
  forceDarkTheme={true}
>
  <div class="finly-b" data-finly-b id="finly-b-top">
    <!-- =====================================================
         HERO — editorial, cinematic product introduction
         ===================================================== -->
    <section class="fb-hero" aria-labelledby="fb-hero-title">
      <div class="fb-hero__texture" aria-hidden="true"></div>
      <div class="fb-hero__glow fb-hero__glow--a" aria-hidden="true"></div>
      <div class="fb-hero__glow fb-hero__glow--b" aria-hidden="true"></div>
      <div class="fb-hero__orbit fb-hero__orbit--a" aria-hidden="true"></div>
      <div class="fb-hero__orbit fb-hero__orbit--b" aria-hidden="true"></div>

      <div class="container fb-hero__layout">
        <div class="fb-hero__copy">
          <div class="fb-kicker" data-fb-hero-kicker>
            <span class="fb-kicker__dot" aria-hidden="true"></span>
            <span>FINLY <i>/</i> PERSONAL FINANCE</span>
          </div>

          <h1 id="fb-hero-title" data-fb-hero-title>
            <span class="fb-title-line">Money,</span>
            <span class="fb-title-line fb-title-line--accent">made clearer.</span>
          </h1>

          <p class="fb-hero__lead" data-fb-hero-lead>
            A thoughtful place for your everyday finances. Track what comes in,
            understand what goes out, and keep your records organised — all
            without an account or login.
          </p>

          <div class="fb-hero__actions" data-fb-hero-actions>
            <a class="fb-button fb-button--primary" href={playUrl} target="_blank" rel="noopener noreferrer">
              <span>Get Finly on Google Play</span>
              <span class="fb-button__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="fb-button fb-button--quiet" href="#fb-story">
              <span>Discover Finly</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="fb-hero__facts" data-fb-hero-facts>
            <span>No account required</span>
            <i aria-hidden="true"></i>
            <span>Works offline</span>
            <i aria-hidden="true"></i>
            <span>Completely ad-free</span>
          </div>
        </div>

        <!-- Conceptual composition, not a screenshot of the shipped app. -->
        <div class="fb-hero-art" aria-label="Illustrative Finly finance interface composition">
          <div class="fb-hero-art__halo" aria-hidden="true"></div>
          <div class="fb-hero-art__ring fb-hero-art__ring--one" aria-hidden="true"></div>
          <div class="fb-hero-art__ring fb-hero-art__ring--two" aria-hidden="true"></div>

          <div class="fb-glass-note fb-glass-note--top" data-fb-float="-9">
            <span class="fb-glass-note__symbol fb-glass-note__symbol--income">↗</span>
            <span><small>INCOME</small><strong>Clearly recorded</strong></span>
          </div>

          <div class="fb-phone" data-fb-phone>
            <div class="fb-phone__rim">
              <div class="fb-phone__island"></div>
                  <img
                    class="fb-phone__mobile-image"
                    src={`${base}finly-assets/finly-home-dashboard.webp`}
                    alt="FINLY home dashboard showing cash flow, net worth, spending insights and budget overview"
                    width="921"
                    height="2048"
                    loading="eager"
                    fetchpriority="high"
                  />
              <div class="fb-phone__screen">
                <div class="fb-phone__status"><span>9:41</span><span>● ● ▰</span></div>
                <div class="fb-phone__topbar"><span class="fb-phone__brand">finly<span>.</span></span><span class="fb-phone__dots">•••</span></div>
                <div class="fb-phone__greeting"><small>YOUR MONEY, IN FOCUS</small><strong>Good things start<br/>with a clear view.</strong></div>
                <div class="fb-phone__summary">
                  <div class="fb-phone__summary-head"><span>Financial overview</span><span class="fb-phone__period">OVERVIEW</span></div>
                  <div class="fb-phone__summary-value">••••••</div>
                  <div class="fb-phone__summary-caption">Illustrative interface preview</div>
                  <div class="fb-phone__summary-pills"><span><i></i>Income</span><span><i></i>Expenses</span></div>
                </div>
                <div class="fb-phone__chart-head"><strong>Spending categories</strong><span>VIEW ALL ↗</span></div>
                <div class="fb-phone__chart-row">
                  <svg class="fb-phone__donut" viewBox="0 0 120 120" aria-hidden="true">
                    <circle cx="60" cy="60" r="43" fill="none" stroke="#173B4D" stroke-width="12"/>
                    <circle cx="60" cy="60" r="43" fill="none" stroke="#219EBC" stroke-width="12" stroke-dasharray="94 270" transform="rotate(-90 60 60)"/>
                    <circle cx="60" cy="60" r="43" fill="none" stroke="#FB8500" stroke-width="12" stroke-dasharray="65 270" stroke-dashoffset="-100" transform="rotate(-90 60 60)"/>
                    <circle cx="60" cy="60" r="43" fill="none" stroke="#FFB703" stroke-width="12" stroke-dasharray="48 270" stroke-dashoffset="-171" transform="rotate(-90 60 60)"/>
                    <circle cx="60" cy="60" r="43" fill="none" stroke="#2A9D8F" stroke-width="12" stroke-dasharray="35 270" stroke-dashoffset="-225" transform="rotate(-90 60 60)"/>
                    <circle cx="60" cy="60" r="43" fill="none" stroke="#8ECAE6" stroke-width="12" stroke-dasharray="23 270" stroke-dashoffset="-266" transform="rotate(-90 60 60)"/>
                  </svg>
                  <div class="fb-phone__legend"><span><i style="--c:#219EBC"></i>Categories</span><span><i style="--c:#FB8500"></i>Spending</span><span><i style="--c:#FFB703"></i>Other activity</span></div>
                </div>
                <div class="fb-phone__activity-head"><strong>Recent activity</strong><span>•••</span></div>
                <div class="fb-phone__activity"><i class="fb-activity-icon fb-activity-icon--blue">↗</i><span>Income entry<small>Transaction record</small></span><b>••••</b></div>
                <div class="fb-phone__activity"><i class="fb-activity-icon fb-activity-icon--orange">↘</i><span>Expense entry<small>Transaction record</small></span><b>••••</b></div>
                <div class="fb-phone__nav"><i class="is-active"></i><i></i><i></i><i></i></div>
              </div>
            </div>
            <span class="fb-phone__caption">CONCEPTUAL PRODUCT VISUAL · NOT AN APP SCREENSHOT</span>
          </div>

          <div class="fb-glass-note fb-glass-note--bottom" data-fb-float="8">
            <span class="fb-glass-note__symbol fb-glass-note__symbol--expense">◌</span>
            <span><small>EVERYDAY FINANCES</small><strong>Thoughtfully organised</strong></span>
          </div>
          <span class="fb-hero-art__index" aria-hidden="true">01 <i></i> FINANCIAL CLARITY</span>
        </div>
      </div>

      <div class="container fb-hero__footer">
        <span><i aria-hidden="true"></i> PERSONAL FINANCE, WITHOUT THE NOISE</span>
        <a href="#fb-story">SCROLL TO EXPLORE <b aria-hidden="true">↓</b></a>
      </div>
    </section>

    <!-- =====================================================
         BRAND PROMISE — quiet editorial transition
         ===================================================== -->
    <section class="fb-manifesto" aria-labelledby="fb-manifesto-title">
      <div class="container fb-manifesto__inner">
        <span class="fb-eyebrow" data-fb-reveal>LESS CLUTTER. MORE CLARITY.</span>
        <h2 id="fb-manifesto-title" data-fb-reveal>
          Your money has a story.<br/>
          <em>Finly helps you see it.</em>
        </h2>
        <div class="fb-manifesto__bottom" data-fb-reveal>
          <p>From the small things you spend on every day to the plans you make for tomorrow, keep your financial activity together in one considered experience.</p>
          <span class="fb-manifesto__index">A MORE CONSIDERED WAY TO KEEP TRACK <b>↘</b></span>
        </div>
      </div>
    </section>

    <!-- =====================================================
         MIND FLOW-INSPIRED PROCESS — sticky visual + scroll steps
         ===================================================== -->
    <section class="fb-story" id="fb-story" aria-labelledby="fb-story-title">
      <div class="container">
        <div class="fb-story__heading" data-fb-reveal>
          <span class="fb-eyebrow">A SIMPLE FLOW FOR EVERYDAY MONEY</span>
          <h2 id="fb-story-title">From the everyday<br/><em>to the bigger picture.</em></h2>
          <p>Move through the parts of personal finance that matter — with your records, insights and plans kept in one place.</p>
        </div>

        <div class="fb-story__layout">
          <div class="fb-story__steps">
            <article class="fb-story-step is-active" data-fb-step="0">
              <div class="fb-story-step__number">01 <span>RECORD</span></div>
              <h3>Keep the everyday<br/>in order.</h3>
              <p>Record income and expenses, organise entries into categories, and attach receipts to the transactions you want to keep together.</p>
              <div class="fb-story-step__meta"><i></i> DAILY TRANSACTIONS</div>
            </article>
            <article class="fb-story-step" data-fb-step="1">
              <div class="fb-story-step__number">02 <span>UNDERSTAND</span></div>
              <h3>See where your<br/>money goes.</h3>
              <p>Use visual category breakdowns and spending analytics to make your recorded financial activity easier to understand.</p>
              <div class="fb-story-step__meta"><i></i> CATEGORIES & ANALYTICS</div>
            </article>
            <article class="fb-story-step" data-fb-step="2">
              <div class="fb-story-step__number">03 <span>PLAN</span></div>
              <h3>Make space for<br/>what comes next.</h3>
              <p>Keep future and recurring transactions in view. Set budget limits and receive alerts to stay aware of your spending.</p>
              <div class="fb-story-step__meta"><i></i> BUDGETS & PLANNING</div>
            </article>
            <article class="fb-story-step" data-fb-step="3">
              <div class="fb-story-step__number">04 <span>KEEP CONTROL</span></div>
              <h3>Your records stay<br/>within reach.</h3>
              <p>Export your ledgers when you need them, keep records on your device, and choose whether to use your own Google Drive for backup.</p>
              <div class="fb-story-step__meta"><i></i> EXPORT & PRIVACY</div>
            </article>
          </div>

          <div class="fb-story__visual-wrap">
            <div class="fb-story__visual-sticky">
              <div class="fb-story__visual-top"><span>FINLY / YOUR FINANCIAL WORKSPACE</span><span class="fb-live-dot"></span></div>
              <div class="fb-story-stage" data-fb-story-stage>
                <!-- State 1: transactions -->
                <div class="fb-state fb-state--transactions is-active" data-fb-state="0" aria-hidden="false">
                  <div class="fb-state__head"><span class="fb-state__eyebrow">YOUR ACTIVITY</span><strong>Everything, in its place.</strong><small>AN ILLUSTRATIVE UI CONCEPT</small></div>
                  <div class="fb-ledger">
                    <div class="fb-ledger__row"><span class="fb-ledger__icon is-blue">↗</span><span><b>Income</b><small>Transaction record</small></span><i class="fb-ledger__tag">INCOME</i><strong class="is-blue-text">••••</strong></div>
                    <div class="fb-ledger__row"><span class="fb-ledger__icon is-orange">↘</span><span><b>Everyday expense</b><small>Transaction record</small></span><i class="fb-ledger__tag">EXPENSE</i><strong class="is-orange-text">••••</strong></div>
                    <div class="fb-ledger__row"><span class="fb-ledger__icon is-sky">◇</span><span><b>Transfer</b><small>Transaction record</small></span><i class="fb-ledger__tag">TRANSFER</i><strong class="is-sky-text">••••</strong></div>
                    <div class="fb-ledger__row"><span class="fb-ledger__icon is-gold">＋</span><span><b>Custom category</b><small>Organised your way</small></span><i class="fb-ledger__tag">CATEGORY</i><strong class="is-gold-text">••••</strong></div>
                  </div>
                  <div class="fb-state__foot"><span>INCOME</span><i></i><span>EXPENSES</span><i></i><span>TRANSFERS</span></div>
                </div>

                <!-- State 2: category analytics -->
                <div class="fb-state fb-state--analytics" data-fb-state="1" aria-hidden="true" hidden>
                  <div class="fb-state__head"><span class="fb-state__eyebrow">VISUAL ANALYTICS</span><strong>Patterns, brought into focus.</strong><small>ILLUSTRATIVE CATEGORY VISUAL</small></div>
                  <div class="fb-analysis-layout">
                    <div class="fb-large-donut-wrap">
                      <svg class="fb-large-donut" viewBox="0 0 240 240" role="img" aria-label="Illustrative multi-colour spending category donut chart">
                        <circle class="fb-large-donut__track" cx="120" cy="120" r="91"/>
                        <circle class="fb-large-donut__slice" data-fb-donut cx="120" cy="120" r="91" stroke="#219EBC" stroke-dasharray="105 572" stroke-dashoffset="0"/>
                        <circle class="fb-large-donut__slice" data-fb-donut cx="120" cy="120" r="91" stroke="#FB8500" stroke-dasharray="94 572" stroke-dashoffset="-111"/>
                        <circle class="fb-large-donut__slice" data-fb-donut cx="120" cy="120" r="91" stroke="#FFB703" stroke-dasharray="82 572" stroke-dashoffset="-211"/>
                        <circle class="fb-large-donut__slice" data-fb-donut cx="120" cy="120" r="91" stroke="#2A9D8F" stroke-dasharray="76 572" stroke-dashoffset="-299"/>
                        <circle class="fb-large-donut__slice" data-fb-donut cx="120" cy="120" r="91" stroke="#E76F51" stroke-dasharray="69 572" stroke-dashoffset="-381"/>
                        <circle class="fb-large-donut__slice" data-fb-donut cx="120" cy="120" r="91" stroke="#8ECAE6" stroke-dasharray="63 572" stroke-dashoffset="-456"/>
                        <text x="120" y="113" text-anchor="middle" class="fb-donut-centre">CATEGORIES</text>
                        <text x="120" y="134" text-anchor="middle" class="fb-donut-sub">VISUAL BREAKDOWN</text>
                      </svg>
                    </div>
                    <div class="fb-analysis-legend">
                      <span><i style="--swatch:#219EBC"></i>Income</span>
                      <span><i style="--swatch:#FB8500"></i>Expenses</span>
                      <span><i style="--swatch:#FFB703"></i>Category</span>
                      <span><i style="--swatch:#2A9D8F"></i>Category</span>
                      <span><i style="--swatch:#E76F51"></i>Category</span>
                      <span><i style="--swatch:#8ECAE6"></i>Transfers</span>
                    </div>
                  </div>
                  <p class="fb-state__disclaimer">Illustrative visualisation, not actual financial data.</p>
                </div>

                <!-- State 3: budgets -->
                <div class="fb-state fb-state--budgets" data-fb-state="2" aria-hidden="true" hidden>
                  <div class="fb-state__head"><span class="fb-state__eyebrow">BUDGETS & PLANNING</span><strong>Make your limits visible.</strong><small>ILLUSTRATIVE BUDGET UI</small></div>
                  <div class="fb-budget-list">
                    <div class="fb-budget-row"><div><span>Monthly budget</span><b>Keep a clear limit</b></div><strong class="fb-budget-value">72%</strong><div class="fb-progress"><i data-fb-progress="72" style="--fb-progress:72%"></i></div></div>
                    <div class="fb-budget-row"><div><span>Everyday spending</span><b>Watch category activity</b></div><strong class="fb-budget-value is-orange-text">54%</strong><div class="fb-progress"><i data-fb-progress="54" style="--fb-progress:54%" class="is-orange-fill"></i></div></div>
                    <div class="fb-budget-row"><div><span>Future transactions</span><b>Keep upcoming entries in view</b></div><strong class="fb-budget-status">PLANNED</strong><div class="fb-progress"><i data-fb-progress="86" style="--fb-progress:86%" class="is-sky-fill"></i></div></div>
                  </div>
                  <div class="fb-budget-note"><span>↗</span><p>Budget limits and alerts help you stay aware of your spending.</p></div>
                  <p class="fb-state__disclaimer">Progress indicators are illustrative, not actual account data.</p>
                </div>

                <!-- State 4: privacy and exports -->
                <div class="fb-state fb-state--control" data-fb-state="3" aria-hidden="true" hidden>
                  <div class="fb-state__head"><span class="fb-state__eyebrow">YOUR RECORDS, YOUR CHOICE</span><strong>Keep control of your information.</strong><small>FINLY PRIVACY APPROACH</small></div>
                  <div class="fb-control-stack">
                    <div class="fb-control-row"><span class="fb-control-icon is-blue">⌂</span><span><b>Local records</b><small>Stored on your device</small></span><em>ON DEVICE</em></div>
                    <div class="fb-control-row"><span class="fb-control-icon is-gold">☁</span><span><b>Google Drive backup</b><small>Optional, with your permission</small></span><em>YOUR CHOICE</em></div>
                    <div class="fb-control-row"><span class="fb-control-icon is-orange">⇩</span><span><b>Ledger export</b><small>PDF and CSV formats</small></span><em>AVAILABLE</em></div>
                  </div>
                  <div class="fb-control-foot"><span>NO ACCOUNT</span><i></i><span>NO LOGIN</span><i></i><span>AD-FREE</span></div>
                </div>
              </div>
              <div class="fb-story__visual-bottom"><span>FINLY PRODUCT STORY</span><span data-fb-state-label>01 / RECORD</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         FINORIX-INSPIRED FINANCIAL VISUALS — rich analytics
         ===================================================== -->
    <section class="fb-insights" id="fb-insights" aria-labelledby="fb-insights-title">
      <div class="container">
        <div class="fb-insights__intro" data-fb-reveal>
          <div><span class="fb-eyebrow">FINANCIAL DETAILS, VISUALLY ORGANISED</span><h2 id="fb-insights-title">A clearer picture<br/><em>is easier to act on.</em></h2></div>
          <p>Bring recorded activity into focus with category breakdowns, budget views and carefully organised financial information.</p>
        </div>

        <div class="fb-dashboard">
          <div class="fb-dashboard__bar"><span><i></i> FINLY / ANALYTICS PREVIEW</span><span>VISUAL CONCEPT <b>↗</b></span></div>
          <div class="fb-dashboard__grid">
            <article class="fb-dashboard-card fb-dashboard-card--donut" data-fb-chart data-fb-reveal>
              <div class="fb-dashboard-card__head"><div><span class="fb-card-overline">CATEGORY DISTRIBUTION</span><h3>Spending, by category.</h3></div><span class="fb-card-number">01</span></div>
              <div class="fb-dashboard-donut-row">
                <svg class="fb-dashboard-donut" viewBox="0 0 180 180" role="img" aria-label="Illustrative multi-category donut chart">
                  <circle cx="90" cy="90" r="68" class="fb-chart-track"/>
                  <circle cx="90" cy="90" r="68" class="fb-chart-slice" data-fb-segment stroke="#219EBC" stroke-dasharray="100 427" stroke-dashoffset="0"/>
                  <circle cx="90" cy="90" r="68" class="fb-chart-slice" data-fb-segment stroke="#FB8500" stroke-dasharray="79 427" stroke-dashoffset="-106"/>
                  <circle cx="90" cy="90" r="68" class="fb-chart-slice" data-fb-segment stroke="#FFB703" stroke-dasharray="67 427" stroke-dashoffset="-191"/>
                  <circle cx="90" cy="90" r="68" class="fb-chart-slice" data-fb-segment stroke="#2A9D8F" stroke-dasharray="57 427" stroke-dashoffset="-264"/>
                  <circle cx="90" cy="90" r="68" class="fb-chart-slice" data-fb-segment stroke="#E76F51" stroke-dasharray="52 427" stroke-dashoffset="-327"/>
                  <circle cx="90" cy="90" r="68" class="fb-chart-slice" data-fb-segment stroke="#8ECAE6" stroke-dasharray="42 427" stroke-dashoffset="-385"/>
                  <text x="90" y="87" class="fb-chart-centre" text-anchor="middle">CATEGORIES</text><text x="90" y="103" class="fb-chart-centre-sub" text-anchor="middle">OVERVIEW</text>
                </svg>
                <div class="fb-dashboard-legend">
                  <span><i style="--swatch:#219EBC"></i>Income</span><span><i style="--swatch:#FB8500"></i>Expenses</span><span><i style="--swatch:#FFB703"></i>Category</span><span><i style="--swatch:#2A9D8F"></i>Category</span><span><i style="--swatch:#E76F51"></i>Category</span><span><i style="--swatch:#8ECAE6"></i>Transfers</span>
                </div>
              </div>
              <p class="fb-chart-disclaimer">Illustrative category visualisation, not actual account data.</p>
            </article>

            <article class="fb-dashboard-card fb-dashboard-card--bars" data-fb-chart data-fb-reveal>
              <div class="fb-dashboard-card__head"><div><span class="fb-card-overline">CASH FLOW VISUAL</span><h3>Compare activity.</h3></div><span class="fb-card-number">02</span></div>
              <div class="fb-bars" role="img" aria-label="Illustrative grouped income and expense bar chart">
                <div class="fb-bars__grid"><i></i><i></i><i></i><i></i></div>
                <div class="fb-bars__groups">
                  <div class="fb-bars__group"><i data-fb-bar style="--bar:48%" class="fb-bar--income"></i><i data-fb-bar style="--bar:66%" class="fb-bar--expense"></i><span>W1</span></div>
                  <div class="fb-bars__group"><i data-fb-bar style="--bar:75%" class="fb-bar--income"></i><i data-fb-bar style="--bar:42%" class="fb-bar--expense"></i><span>W2</span></div>
                  <div class="fb-bars__group"><i data-fb-bar style="--bar:60%" class="fb-bar--income"></i><i data-fb-bar style="--bar:82%" class="fb-bar--expense"></i><span>W3</span></div>
                  <div class="fb-bars__group"><i data-fb-bar style="--bar:88%" class="fb-bar--income"></i><i data-fb-bar style="--bar:55%" class="fb-bar--expense"></i><span>W4</span></div>
                  <div class="fb-bars__group"><i data-fb-bar style="--bar:69%" class="fb-bar--income"></i><i data-fb-bar style="--bar:47%" class="fb-bar--expense"></i><span>W5</span></div>
                </div>
              </div>
              <div class="fb-chart-key"><span><i style="--swatch:#219EBC"></i>Income</span><span><i style="--swatch:#FB8500"></i>Expenses</span></div>
              <p class="fb-chart-disclaimer">Illustrative comparison, not actual account data.</p>
            </article>

            <article class="fb-dashboard-card fb-dashboard-card--line" data-fb-chart data-fb-reveal>
              <div class="fb-dashboard-card__head"><div><span class="fb-card-overline">FINANCIAL ACTIVITY</span><h3>Look beyond a single entry.</h3></div><span class="fb-card-number">03</span></div>
              <div class="fb-line-plot">
                <div class="fb-line-plot__grid"><i></i><i></i><i></i><i></i></div>
                <svg viewBox="0 0 720 190" preserveAspectRatio="none" role="img" aria-label="Illustrative financial trend lines">
                  <defs><linearGradient id="fb-line-area" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#219EBC" stop-opacity=".24"/><stop offset="1" stop-color="#219EBC" stop-opacity="0"/></linearGradient></defs>
                  <path d="M0 132 C55 119 80 54 145 75 S220 137 282 92 S360 40 420 74 S515 111 560 52 S650 36 720 19 L720 190 L0 190Z" fill="url(#fb-line-area)"/>
                  <path data-fb-line d="M0 132 C55 119 80 54 145 75 S220 137 282 92 S360 40 420 74 S515 111 560 52 S650 36 720 19" fill="none" stroke="#219EBC" stroke-width="4" stroke-linecap="round"/>
                  <path data-fb-line d="M0 155 C55 135 82 151 145 133 S220 106 282 128 S360 103 420 121 S515 86 560 109 S650 77 720 91" fill="none" stroke="#FB8500" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="fb-chart-key"><span><i style="--swatch:#219EBC"></i>Income trend</span><span><i style="--swatch:#FB8500"></i>Expense trend</span></div>
              <p class="fb-chart-disclaimer">Illustrative trend visualisation, not an in-app data screenshot.</p>
            </article>

