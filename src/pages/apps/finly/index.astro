<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const page = document.querySelector<HTMLElement>('[data-finly-b]');

  if (page) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (themeColor) themeColor.content = '#011825';

    // Keep the shared header and footer useful on this independent route.
    header?.querySelectorAll('.nav-link.is-current').forEach((link) => link.classList.remove('is-current'));
    const backToTop = document.querySelector<HTMLAnchorElement>('.back-to-top');
    if (backToTop) {
      backToTop.href = '#finly-b-top';
      backToTop.addEventListener('click', (event) => {
        event.preventDefault();
        document.getElementById('finly-b-top')?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
      });
    }

    // Sticky story controller: use GSAP ScrollTrigger so every text step
    // activates its matching visual when it crosses the centre reading line.
    // This supports scrolling down, scrolling back up, direct links and resize.
    const storySteps = Array.from(page.querySelectorAll<HTMLElement>('[data-fb-step]'));
    const storyStates = Array.from(page.querySelectorAll<HTMLElement>('[data-fb-state]'));
    const storyStateLabel = page.querySelector<HTMLElement>('[data-fb-state-label]');
    const storyLabels = ['01 / RECORD', '02 / UNDERSTAND', '03 / PLAN', '04 / KEEP CONTROL'];
    // On phones, pair every story explanation with its own matching visual.
    // Desktop keeps the original single sticky visual panel unchanged.
    const buildMobileStoryVisuals = () => {
      page.querySelectorAll<HTMLElement>('.fb-story-mobile-visual').forEach((node) => node.remove());
      if (!window.matchMedia('(max-width: 820px)').matches) return;

      const topTemplate = page.querySelector<HTMLElement>('.fb-story__visual-top');
      const bottomTemplate = page.querySelector<HTMLElement>('.fb-story__visual-bottom');

      storySteps.forEach((step, index) => {
        const source = storyStates[index];
        if (!source) return;

        const card = document.createElement('div');
        card.className = 'fb-story-mobile-visual';
        card.setAttribute('aria-hidden', 'true');

        if (topTemplate) card.append(topTemplate.cloneNode(true));

        const stage = document.createElement('div');
        stage.className = 'fb-story-mobile-stage';

        const panel = source.cloneNode(true) as HTMLElement;
        panel.hidden = false;
        panel.removeAttribute('data-fb-state');
        panel.removeAttribute('aria-hidden');
        panel.classList.remove('is-active');
        panel.classList.add('fb-state--mobile-static');
        panel.querySelectorAll<HTMLElement>('[id]').forEach((element) => element.removeAttribute('id'));
        panel.querySelectorAll<HTMLElement>('[data-fb-donut], [data-fb-progress]').forEach((element) => {
          element.removeAttribute('data-fb-donut');
          element.removeAttribute('data-fb-progress');
        });
        stage.append(panel);
        card.append(stage);

        if (bottomTemplate) {
          const bottom = bottomTemplate.cloneNode(true) as HTMLElement;
          const label = bottom.querySelector<HTMLElement>('[data-fb-state-label]');
          if (label) {
            label.textContent = storyLabels[index] || storyLabels[0];
            label.removeAttribute('data-fb-state-label');
          }
          card.append(bottom);
        }

        step.append(card);
      });
    };

    buildMobileStoryVisuals();
    let activeStoryIndex = -1;
    const storyTriggers: Array<{ kill: () => void }> = [];

    const animateStoryState = (state: HTMLElement) => {
      if (reducedMotion) return;

      gsap.fromTo(state,
        { y: 16, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: .42, ease: 'power2.out', overwrite: true }
      );

      state.querySelectorAll<SVGCircleElement>('[data-fb-donut]').forEach((slice, index) => {
        const dash = slice.getAttribute('stroke-dasharray')?.split(/\s+/) || [];
        const length = Number(dash[0] || 0);
        gsap.fromTo(slice,
          { strokeDasharray: '0 572', opacity: .35 },
          { strokeDasharray: `${length} 572`, opacity: 1, duration: .95, delay: index * .055, ease: 'power2.out', overwrite: true }
        );
      });

      state.querySelectorAll<HTMLElement>('[data-fb-progress]').forEach((bar) => {
        const target = Number(bar.dataset.fbProgress || 0);
        gsap.fromTo(bar,
          { width: '0%' },
          { width: `${target}%`, duration: .95, ease: 'power3.out', overwrite: true }
        );
      });
    };

    const activateStoryState = (index: number) => {
      if (index < 0 || index >= storyStates.length || index >= storySteps.length || index === activeStoryIndex) return;
      activeStoryIndex = index;

      storySteps.forEach((step, stepIndex) => {
        const active = stepIndex === index;
        step.classList.toggle('is-active', active);
        if (active) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });

      // Keep exactly one visual panel visible at a time.
      storyStates.forEach((state, stateIndex) => {
        const active = stateIndex === index;
        if (!active) {
          gsap.killTweensOf(state);
          state.querySelectorAll('*').forEach((target) => gsap.killTweensOf(target));
        }
        state.hidden = !active;
        state.classList.toggle('is-active', active);
        state.setAttribute('aria-hidden', String(!active));
      });

      const selectedState = storyStates[index];
      if (selectedState) animateStoryState(selectedState);
      if (storyStateLabel) storyStateLabel.textContent = storyLabels[index] || storyLabels[0];
    };

    const syncStoryStateToViewport = () => {
      if (!storySteps.length || storyStates.length !== storySteps.length) return;

      const marker = Math.min(
        Math.max(100, window.innerHeight * .52),
        Math.max(100, window.innerHeight - 110)
      );
      let selectedIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      storySteps.forEach((step, index) => {
        const rect = step.getBoundingClientRect();
        const containsMarker = marker >= rect.top && marker <= rect.bottom;
        const distance = containsMarker
          ? 0
          : marker < rect.top
            ? rect.top - marker
            : marker - rect.bottom;

        if (distance < closestDistance) {
          closestDistance = distance;
          selectedIndex = index;
        }
      });

      activateStoryState(selectedIndex);
    };

    if (storySteps.length && storyStates.length === storySteps.length) {
      storySteps.forEach((step, index) => {
        const trigger = ScrollTrigger.create({
          trigger: step,
          start: 'top 52%',
          end: 'bottom 52%',
          onEnter: () => activateStoryState(index),
          onEnterBack: () => activateStoryState(index)
        });
        storyTriggers.push(trigger);
      });

      // Set the correct panel immediately (including direct links to this section).
      syncStoryStateToViewport();

      // Refresh after fonts/layout settle, then synchronise to the current position.
      requestAnimationFrame(() => {
        ScrollTrigger.refresh();
        syncStoryStateToViewport();
      });
      window.addEventListener('load', () => {
        ScrollTrigger.refresh();
        syncStoryStateToViewport();
      }, { once: true });
      window.addEventListener('resize', () => {
        ScrollTrigger.refresh();
        syncStoryStateToViewport();
      }, { passive: true });
      window.addEventListener('pagehide', () => {
        storyTriggers.forEach((trigger) => trigger.kill());
      }, { once: true });
    } 

    const faqItems = Array.from(page.querySelectorAll<HTMLDetailsElement>('.fb-faq-item'));
    faqItems.forEach((item) => item.addEventListener('toggle', () => {
      if (item.open) faqItems.forEach((other) => { if (other !== item) other.open = false; });
    }));

    if (!reducedMotion) {
      const context = gsap.context(() => {
        // Hero: layered editorial reveal.
        const hero = gsap.timeline({ defaults: { ease: 'power3.out' } });
        hero.from('[data-fb-hero-kicker]', { autoAlpha: 0, y: 16, duration: .65 })
          .from('[data-fb-hero-title] .fb-title-line', { autoAlpha: 0, yPercent: 115, duration: .95, stagger: .15 }, '-=.25')
          .from('[data-fb-hero-lead]', { autoAlpha: 0, y: 22, duration: .75 }, '-=.48')
          .from('[data-fb-hero-actions] > *', { autoAlpha: 0, y: 16, duration: .6, stagger: .1 }, '-=.42')
          .from('[data-fb-hero-facts]', { autoAlpha: 0, y: 12, duration: .55 }, '-=.35')
          .from('.fb-phone', { autoAlpha: 0, y: 35, scale: .94, duration: 1.05 }, '-=.95')
          .from('.fb-glass-note', { autoAlpha: 0, y: 18, duration: .7, stagger: .13 }, '-=.65');

        // Gentle pointer parallax on the hero product composition.
        const heroElement = page.querySelector<HTMLElement>('.fb-hero');
        const phone = page.querySelector<HTMLElement>('[data-fb-phone]');
        if (heroElement && phone && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
          const onPointer = (event: PointerEvent) => {
            const rect = heroElement.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - .5;
            const y = (event.clientY - rect.top) / rect.height - .5;
            gsap.to(phone, { x: x * 9, y: y * 8, duration: .7, ease: 'power2.out', overwrite: 'auto' });
          };
          const reset = () => gsap.to(phone, { x: 0, y: 0, duration: .8, ease: 'power3.out', overwrite: 'auto' });
          heroElement.addEventListener('pointermove', onPointer, { passive: true });
          heroElement.addEventListener('pointerleave', reset, { passive: true });
        }

        // Reveal the editorial sections only when they enter the viewport.
        page.querySelectorAll<HTMLElement>('[data-fb-reveal]').forEach((element) => {
          gsap.fromTo(element, { autoAlpha: 0, y: 28 }, {
            autoAlpha: 1, y: 0, duration: .85, ease: 'power3.out',
            scrollTrigger: { trigger: element, start: 'top 86%', once: true }
          });
        });

        // Dashboard charts: animate on first entrance, not continuously.
        page.querySelectorAll<HTMLElement>('[data-fb-chart]').forEach((chart) => {
          ScrollTrigger.create({
            trigger: chart,
            start: 'top 82%',
            once: true,
            onEnter: () => {
              const segments = chart.querySelectorAll<SVGCircleElement>('[data-fb-segment]');
              segments.forEach((segment, index) => {
                const first = Number(segment.getAttribute('stroke-dasharray')?.split(/\s+/)[0] || 0);
                gsap.fromTo(segment, { strokeDasharray: `0 427`, opacity: .45 }, { strokeDasharray: `${first} 427`, opacity: 1, duration: 1.15, delay: index * .07, ease: 'power2.out' });
              });
              gsap.fromTo(chart.querySelectorAll<HTMLElement>('[data-fb-bar]'), { scaleY: 0, transformOrigin: 'bottom' }, { scaleY: 1, duration: .9, stagger: .06, ease: 'power3.out' });
              chart.querySelectorAll<SVGPathElement>('[data-fb-line]').forEach((path, index) => {
                const length = path.getTotalLength();
                gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
                gsap.to(path, { strokeDashoffset: 0, duration: 1.7, delay: index * .2, ease: 'power2.inOut' });
              });
              chart.querySelectorAll<HTMLElement>('[data-fb-progress]').forEach((bar) => {
                const target = Number(bar.dataset.fbProgress || 0);
                gsap.to(bar, { width: `${target}%`, duration: 1.1, ease: 'power3.out' });
              });
            }
          });
        });

        // Small depth shift on the privacy emblem as it reaches the viewport.
        const privacyVisual = page.querySelector<HTMLElement>('.fb-privacy-visual');
        if (privacyVisual) {
          gsap.fromTo(privacyVisual, { y: 28, autoAlpha: 0 }, {
            y: 0, autoAlpha: 1, duration: .9, ease: 'power3.out',
            scrollTrigger: { trigger: privacyVisual, start: 'top 82%', once: true }
          });
        }
      }, page);

      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
      window.addEventListener('pagehide', () => context.revert(), { once: true });
    }
  }
</script>
