.fb-phone__summary { margin-top: 19px; padding: 14px; border: 1px solid rgba(142,202,230,.16); border-radius: 15px; background: linear-gradient(135deg, rgba(33,158,188,.15), rgba(3,38,56,.65)); }
.fb-phone__summary-head { display: flex; justify-content: space-between; color: #B8CBD4; font-size: 8px; }
.fb-phone__period { color: var(--fb-sky); font-size: 6px; letter-spacing: .1em; }
.fb-phone__summary-value { margin-top: 10px; color: #F5FAFC; font-size: 23px; letter-spacing: .14em; }
.fb-phone__summary-caption { margin-top: 4px; color: #7899A9; font-size: 6px; }
.fb-phone__summary-pills { display: flex; gap: 14px; margin-top: 13px; color: #B8CBD4; font-size: 7px; }
.fb-phone__summary-pills span { display: flex; align-items: center; gap: 5px; }
.fb-phone__summary-pills i { width: 6px; height: 6px; border-radius: 50%; background: #219EBC; }
.fb-phone__summary-pills span + span i { background: #FB8500; }
.fb-phone__chart-head, .fb-phone__activity-head { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; }
.fb-phone__chart-head strong, .fb-phone__activity-head strong { font-size: 9px; }
.fb-phone__chart-head span, .fb-phone__activity-head span { color: var(--fb-sky); font-size: 7px; }
.fb-phone__chart-row { display: flex; align-items: center; justify-content: space-around; gap: 8px; margin-top: 6px; }
.fb-phone__donut { width: 120px; flex: 0 0 120px; }
.fb-phone__legend { display: grid; gap: 9px; color: #A4BBC7; font-size: 7px; }
.fb-phone__legend span { display: flex; align-items: center; gap: 6px; }
.fb-phone__legend i { width: 6px; height: 6px; border-radius: 2px; background: var(--c); }
.fb-phone__activity-head { margin-top: 12px; }
.fb-phone__activity { display: flex; align-items: center; gap: 8px; padding: 8px 0; border-top: 1px solid rgba(142,202,230,.1); }
.fb-phone__activity > span { flex: 1; color: #F5FAFC; font-size: 8px; }
.fb-phone__activity small { display: block; margin-top: 3px; color: #7899A9; font-size: 6px; }
.fb-phone__activity > b { color: #B8CBD4; font-size: 8px; letter-spacing: .1em; }
.fb-activity-icon { display: grid; width: 26px; height: 26px; place-items: center; border-radius: 8px; font-style: normal; }
.fb-activity-icon--blue { background: rgba(33,158,188,.15); color: #219EBC; }
.fb-activity-icon--orange { background: rgba(251,133,0,.13); color: #FB8500; }
.fb-phone__nav { display: flex; justify-content: space-around; margin-top: 10px; }
.fb-phone__nav i { width: 15px; height: 4px; border-radius: 5px; background: rgba(142,202,230,.32); }
.fb-phone__nav i.is-active { background: var(--fb-blue); }
.fb-phone__caption { display: block; margin-top: 13px; color: rgba(142,202,230,.66); font-size: 7px; font-weight: 600; letter-spacing: .12em; text-align: center; }
.fb-glass-note { position: absolute; z-index: 5; display: flex; align-items: center; gap: 10px; padding: 12px 15px; border: 1px solid rgba(142,202,230,.2); border-radius: 14px; background: rgba(3,38,56,.85); box-shadow: 0 18px 48px rgba(0,0,0,.28); backdrop-filter: blur(18px); }
.fb-glass-note--top { top: 19%; right: -1%; }
.fb-glass-note--bottom { bottom: 17%; left: -2%; }
.fb-glass-note__symbol { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 10px; font-size: 17px; }
.fb-glass-note__symbol--income { background: rgba(33,158,188,.16); color: #219EBC; }
.fb-glass-note__symbol--expense { background: rgba(251,133,0,.13); color: #FB8500; }
.fb-glass-note small { display: block; color: #8ECAE6; font-size: 7px; letter-spacing: .12em; }
.fb-glass-note strong { display: block; margin-top: 3px; color: #F5FAFC; font-size: 9px; }
.fb-hero-art__index { position: absolute; right: 0; bottom: 8%; display: flex; align-items: center; gap: 10px; color: rgba(142,202,230,.56); font-size: 7px; letter-spacing: .13em; }
.fb-hero-art__index i { width: 35px; height: 1px; background: rgba(142,202,230,.38); }
.fb-hero__footer { position: absolute; right: auto; bottom: 25px; left: 50%; width: min(calc(100% - clamp(36px, 9vw, 144px)), 1280px); transform: translateX(-50%); display: flex; align-items: center; justify-content: space-between; gap: 20px; color: #7899A9; font-size: 8px; font-weight: 600; letter-spacing: .14em; }
.fb-hero__footer > span { display: flex; align-items: center; gap: 9px; }
.fb-hero__footer > span i { width: 6px; height: 6px; border-radius: 50%; background: var(--fb-blue); box-shadow: 0 0 12px var(--fb-blue); }
.fb-hero__footer a { display: flex; align-items: center; gap: 9px; color: var(--fb-sky); }
.fb-hero__footer a b { color: var(--fb-amber); font-size: 13px; transition: transform .2s ease; }
.fb-hero__footer a:hover b { transform: translateY(4px); }

/* MANIFESTO */
.fb-manifesto { position: relative; padding: clamp(100px, 12vw, 175px) 0; background: #061F2D; overflow: hidden; }
.fb-manifesto::before { position: absolute; top: -55%; right: -12%; width: 65vw; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(33,158,188,.12), transparent 69%); content: ''; pointer-events: none; }
.fb-manifesto__inner { position: relative; z-index: 1; }
.fb-manifesto h2 { max-width: 950px; margin: 25px 0 0; color: var(--fb-white); font-size: clamp(48px, 7vw, 91px); font-weight: 500; letter-spacing: -.065em; line-height: 1.02; }
.fb-manifesto h2 em { color: var(--fb-sky); font-style: normal; }
.fb-manifesto__bottom { display: flex; align-items: end; justify-content: space-between; gap: 50px; margin-top: 48px; padding-top: 25px; border-top: 1px solid var(--fb-border); }
.fb-manifesto__bottom p { max-width: 470px; margin: 0; color: var(--fb-text); font-size: 15px; line-height: 1.9; }
.fb-manifesto__index { color: #7899A9; font-size: 8px; letter-spacing: .13em; white-space: nowrap; }
.fb-manifesto__index b { margin-left: 8px; color: var(--fb-amber); font-size: 14px; }

/* STICKY STORY — inspired by MindFlow's 100vh process blocks */
.fb-story { position: relative; padding: clamp(100px, 11vw, 150px) 0 90px; background: var(--fb-bg); }
.fb-story__heading { max-width: 760px; margin-bottom: clamp(55px, 7vw, 90px); }
.fb-story__heading h2 { margin: 22px 0 0; color: var(--fb-white); font-size: clamp(46px, 6vw, 78px); font-weight: 500; letter-spacing: -.06em; line-height: 1.02; }
.fb-story__heading h2 em { color: var(--fb-sky); font-style: normal; }
.fb-story__heading p { max-width: 560px; margin: 22px 0 0; color: var(--fb-text); font-size: 15px; line-height: 1.9; }
.fb-story__layout { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); align-items: stretch; gap: clamp(50px, 8vw, 110px); }
.fb-story__steps { position: relative; }
.fb-story-step { position: relative; min-height: 66vh; display: flex; flex-direction: column; justify-content: center; padding: 40px 0; border-top: 1px solid var(--fb-border); opacity: .38; transition: opacity .4s ease; }
.fb-story-step:last-child { border-bottom: 1px solid var(--fb-border); }
.fb-story-step.is-active { opacity: 1; }
.fb-story-step__number { display: flex; align-items: center; gap: 14px; color: var(--fb-amber); font-size: 11px; font-weight: 700; letter-spacing: .11em; }
.fb-story-step__number span { color: var(--fb-sky); font-size: 8px; letter-spacing: .15em; }
.fb-story-step h3 { margin: 24px 0 17px; color: var(--fb-white); font-size: clamp(34px, 4vw, 52px); font-weight: 500; letter-spacing: -.055em; line-height: 1.04; }
.fb-story-step p { max-width: 390px; margin: 0; color: var(--fb-text); font-size: 14px; line-height: 1.95; }
.fb-story-step__meta { display: flex; align-items: center; gap: 9px; margin-top: 28px; color: #7899A9; font-size: 8px; letter-spacing: .14em; }
.fb-story-step__meta i { width: 6px; height: 6px; border-radius: 50%; background: var(--fb-blue); box-shadow: 0 0 11px rgba(33,158,188,.55); }
.fb-story__visual-wrap { min-width: 0; align-self: stretch; }
.fb-story__visual-sticky { position: sticky; top: 112px; overflow: hidden; border: 1px solid rgba(142,202,230,.19); border-radius: 25px; background: radial-gradient(ellipse at 100% 0%, rgba(33,158,188,.12), transparent 49%), linear-gradient(145deg, #073047, #032638 78%); box-shadow: 0 30px 85px rgba(0,0,0,.27); }
.fb-story__visual-top, .fb-story__visual-bottom { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 18px 22px; color: #8ECAE6; font-size: 8px; font-weight: 600; letter-spacing: .13em; }
.fb-story__visual-top { border-bottom: 1px solid rgba(142,202,230,.13); }
.fb-live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--fb-green); box-shadow: 0 0 12px var(--fb-green); }
.fb-story-stage { position: relative; height: 540px; min-height: 540px; overflow: hidden; padding: 30px clamp(22px, 3vw, 38px); }
.fb-state { position: absolute; inset: 30px clamp(22px, 3vw, 38px); display: none; flex-direction: column; justify-content: center; opacity: 0; visibility: hidden; transform: translateY(16px) scale(.99); pointer-events: none; }
.fb-state[hidden] { display: none !important; }
.fb-state.is-active:not([hidden]) { display: flex; opacity: 1; visibility: visible; transform: translateY(0) scale(1); pointer-events: auto; }
.fb-state__head { display: grid; gap: 8px; }
.fb-state__eyebrow { color: var(--fb-sky); font-size: 8px; font-weight: 700; letter-spacing: .14em; }
.fb-state__head strong { color: var(--fb-white); font-family: 'Instrument Sans', sans-serif; font-size: clamp(23px, 2.5vw, 32px); font-weight: 500; letter-spacing: -.04em; }
.fb-state__head small { color: #7899A9; font-size: 7px; letter-spacing: .12em; }
.fb-ledger { display: grid; gap: 10px; margin-top: 34px; }
.fb-ledger__row { display: grid; grid-template-columns: 34px minmax(0,1fr) auto auto; align-items: center; gap: 10px; min-width: 0; padding: 13px; border: 1px solid rgba(142,202,230,.13); border-radius: 13px; background: rgba(255,255,255,.025); }
.fb-ledger__icon { display: grid; width: 32px; height: 32px; place-items: center; border-radius: 9px; font-style: normal; }
.fb-ledger__icon.is-blue { background: rgba(33,158,188,.14); color: #219EBC; }
.fb-ledger__icon.is-orange { background: rgba(251,133,0,.13); color: #FB8500; }
.fb-ledger__icon.is-sky { background: rgba(142,202,230,.13); color: #8ECAE6; }
.fb-ledger__icon.is-gold { background: rgba(255,183,3,.12); color: #FFB703; }
.fb-ledger__row > span:nth-child(2) { min-width: 0; }
.fb-ledger__row b { display: block; color: #F5FAFC; font-size: 10px; font-weight: 600; }
.fb-ledger__row small { display: block; margin-top: 3px; color: #7899A9; font-size: 8px; }
.fb-ledger__row strong { font-size: 9px; letter-spacing: .08em; }
.fb-ledger__tag { padding: 5px 6px; border: 1px solid rgba(142,202,230,.12); border-radius: 5px; color: #7899A9; font-size: 6px; font-style: normal; letter-spacing: .09em; }
.is-blue-text { color: #219EBC !important; }.is-orange-text { color: #FB8500 !important; }.is-sky-text { color: #8ECAE6 !important; }.is-gold-text { color: #FFB703 !important; }
.fb-state__foot { display: flex; align-items: center; gap: 10px; margin-top: 25px; color: #7899A9; font-size: 7px; letter-spacing: .1em; }
.fb-state__foot i { width: 3px; height: 3px; border-radius: 50%; background: var(--fb-amber); }
.fb-analysis-layout { display: flex; align-items: center; justify-content: center; gap: clamp(12px, 3vw, 32px); margin-top: 18px; }
.fb-large-donut-wrap { flex: 0 1 235px; }
.fb-large-donut { width: 100%; overflow: visible; transform: rotate(-90deg); }
.fb-large-donut__track, .fb-large-donut__slice { fill: none; stroke-width: 18; }
.fb-large-donut__track { stroke: #163F51; }
.fb-large-donut__slice { stroke-linecap: round; filter: drop-shadow(0 0 5px currentColor); }
.fb-donut-centre { fill: #F5FAFC; font-size: 10px; font-weight: 700; letter-spacing: .1em; }
.fb-donut-sub { fill: #8ECAE6; font-size: 7px; letter-spacing: .07em; }
.fb-analysis-legend { display: grid; gap: 11px; min-width: 110px; }
.fb-analysis-legend span { display: flex; align-items: center; gap: 8px; color: #B8CBD4; font-size: 9px; }
.fb-analysis-legend i, .fb-chart-key i { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 3px; background: var(--swatch); box-shadow: 0 0 9px color-mix(in srgb, var(--swatch), transparent 58%); }
.fb-state__disclaimer { margin: 17px 0 0; color: #7899A9; font-size: 8px; line-height: 1.7; }
.fb-budget-list { display: grid; gap: 19px; margin-top: 35px; }
.fb-budget-row { display: grid; grid-template-columns: 1fr auto; gap: 11px; }
.fb-budget-row > div:first-child span { display: block; color: #F5FAFC; font-size: 10px; font-weight: 600; }
.fb-budget-row > div:first-child b { display: block; margin-top: 4px; color: #7899A9; font-size: 8px; font-weight: 400; }
.fb-budget-value { color: var(--fb-amber); font-size: 12px; }
.fb-budget-status { color: var(--fb-sky); font-size: 8px; letter-spacing: .08em; }
.fb-progress { grid-column: 1 / -1; height: 8px; overflow: hidden; border-radius: 20px; background: #153C4F; }
.fb-progress i { display: block; width: var(--fb-progress, 0%); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #FFB703, #FB8500); }
.fb-progress i.is-orange-fill { background: linear-gradient(90deg, #F4A261, #FB8500); }
.fb-progress i.is-sky-fill { background: linear-gradient(90deg, #219EBC, #8ECAE6); }
.fb-budget-note { display: flex; gap: 12px; align-items: center; margin-top: 28px; padding: 15px; border: 1px solid rgba(33,158,188,.18); border-radius: 12px; background: rgba(33,158,188,.07); }
.fb-budget-note > span { color: var(--fb-amber); font-size: 19px; }
.fb-budget-note p { margin: 0; color: #B8CBD4; font-size: 9px; line-height: 1.7; }
.fb-control-stack { display: grid; gap: 11px; margin-top: 32px; }
.fb-control-row { display: grid; grid-template-columns: 34px minmax(0,1fr) auto; align-items: center; gap: 10px; padding: 14px 12px; border: 1px solid rgba(142,202,230,.13); border-radius: 12px; background: rgba(255,255,255,.025); }
.fb-control-icon { display: grid; width: 32px; height: 32px; place-items: center; border-radius: 9px; font-size: 15px; }
.fb-control-icon.is-blue { background: rgba(33,158,188,.13); color: #219EBC; }.fb-control-icon.is-gold { background: rgba(255,183,3,.12); color: #FFB703; }.fb-control-icon.is-orange { background: rgba(251,133,0,.12); color: #FB8500; }
.fb-control-row b { display: block; color: #F5FAFC; font-size: 9px; }.fb-control-row small { display: block; margin-top: 3px; color: #7899A9; font-size: 7px; }
.fb-control-row em { color: #8ECAE6; font-size: 6px; font-style: normal; letter-spacing: .1em; }
.fb-control-foot { display: flex; align-items: center; gap: 9px; margin-top: 23px; color: #7899A9; font-size: 7px; letter-spacing: .1em; }
.fb-control-foot i { width: 3px; height: 3px; border-radius: 50%; background: var(--fb-amber); }
.fb-story__visual-bottom { border-top: 1px solid rgba(142,202,230,.13); color: #7899A9; font-size: 7px; }
.fb-story__visual-bottom span:last-child { color: var(--fb-sky); }

/* INSIGHTS DASHBOARD — Finorix-inspired panel composition */
.fb-insights { padding: clamp(100px, 11vw, 155px) 0; background: #061F2D; overflow: hidden; }
.fb-insights__intro { display: flex; align-items: end; justify-content: space-between; gap: 60px; margin-bottom: 55px; }
.fb-insights__intro h2, .fb-capabilities__intro h2 { margin: 20px 0 0; color: var(--fb-white); font-size: clamp(47px, 6vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1.02; }
.fb-insights__intro h2 em, .fb-capabilities__intro h2 em { color: var(--fb-sky); font-style: normal; }
.fb-insights__intro > p { max-width: 390px; margin: 0 0 7px; color: var(--fb-text); font-size: 14px; line-height: 1.9; }
.fb-dashboard { position: relative; padding: 20px; border: 1px solid rgba(142,202,230,.18); border-radius: 25px; background: linear-gradient(145deg, #082E42, #032638 75%); box-shadow: 0 35px 100px rgba(0,0,0,.25); }
.fb-dashboard__bar, .fb-dashboard__foot { display: flex; justify-content: space-between; align-items: center; gap: 15px; padding: 7px 8px 19px; color: #8ECAE6; font-size: 8px; font-weight: 700; letter-spacing: .12em; }
.fb-dashboard__bar span:first-child { display: flex; align-items: center; gap: 9px; }.fb-dashboard__bar span:first-child i { width: 7px; height: 7px; border-radius: 50%; background: var(--fb-green); box-shadow: 0 0 10px var(--fb-green); }
.fb-dashboard__bar b, .fb-dashboard__foot i { color: var(--fb-amber); font-style: normal; }
.fb-dashboard__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.fb-dashboard-card { min-width: 0; padding: clamp(20px, 3vw, 29px); border: 1px solid rgba(142,202,230,.13); border-radius: 18px; background: linear-gradient(145deg, rgba(10,53,72,.9), rgba(3,38,56,.95)); transition: transform .35s ease, border-color .35s ease; }
.fb-dashboard-card:hover { transform: translateY(-4px); border-color: rgba(33,158,188,.35); }
.fb-dashboard-card--line { grid-column: 1 / 2; }.fb-dashboard-card--budget { grid-column: 2 / 3; }
.fb-dashboard-card__head { display: flex; justify-content: space-between; gap: 12px; }
.fb-card-overline { color: #8ECAE6; font-size: 8px; font-weight: 700; letter-spacing: .13em; }
.fb-dashboard-card h3 { margin: 9px 0 0; color: #F5FAFC; font-size: 22px; font-weight: 500; letter-spacing: -.04em; }
.fb-card-number { color: rgba(142,202,230,.45); font-size: 9px; letter-spacing: .12em; }
.fb-dashboard-donut-row { display: flex; align-items: center; justify-content: space-around; gap: 16px; min-height: 220px; }
.fb-dashboard-donut { width: min(58%, 190px); overflow: visible; transform: rotate(-90deg); }
.fb-chart-track, .fb-chart-slice { fill: none; stroke-width: 15; }.fb-chart-track { stroke: #163F51; }.fb-chart-slice { stroke-linecap: round; filter: drop-shadow(0 0 4px currentColor); }
.fb-chart-centre { fill: #F5FAFC; font-size: 9px; font-weight: 700; letter-spacing: .08em; }.fb-chart-centre-sub { fill: #8ECAE6; font-size: 6px; letter-spacing: .1em; }
.fb-dashboard-legend { display: grid; gap: 11px; min-width: 102px; }.fb-dashboard-legend span, .fb-chart-key span { display: flex; align-items: center; gap: 8px; color: #B8CBD4; font-size: 9px; }.fb-dashboard-legend i, .fb-chart-key i { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 3px; background: var(--swatch); }
.fb-chart-disclaimer { margin: 12px 0 0; padding-top: 12px; border-top: 1px solid rgba(142,202,230,.1); color: #7899A9; font-size: 8px; line-height: 1.65; }
.fb-bars { position: relative; height: 207px; margin-top: 22px; padding: 0 4px 25px; }
.fb-bars__grid, .fb-line-plot__grid { position: absolute; inset: 0 0 25px; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }.fb-bars__grid i, .fb-line-plot__grid i { height: 1px; border-top: 1px dashed rgba(142,202,230,.14); }
.fb-bars__groups { position: relative; display: flex; align-items: stretch; justify-content: space-around; gap: 10px; height: 100%; }
.fb-bars__group { position: relative; display: flex; flex: 1; align-items: end; justify-content: center; gap: 5px; }.fb-bars__group span { position: absolute; bottom: -19px; color: #8EA8B6; font-size: 7px; }
.fb-bars__group > i { display: block; width: clamp(9px, 1.35vw, 16px); height: var(--bar); max-height: 100%; border-radius: 5px 5px 2px 2px; transform-origin: bottom; }
.fb-bar--income { background: linear-gradient(180deg, #7BD3E6, #219EBC); box-shadow: 0 0 16px rgba(33,158,188,.15); }.fb-bar--expense { background: linear-gradient(180deg, #FFBD76, #FB8500); box-shadow: 0 0 16px rgba(251,133,0,.13); }
.fb-chart-key { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 17px; }
.fb-line-plot { position: relative; height: 205px; margin-top: 22px; }.fb-line-plot__grid { inset: 0; }.fb-line-plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }.fb-line-plot path[data-fb-line] { filter: drop-shadow(0 3px 5px rgba(33,158,188,.16)); }
.fb-budget-visual { display: grid; gap: 11px; margin-top: 29px; }.fb-budget-visual__head { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: #F5FAFC; font-size: 10px; }.fb-budget-visual__head b { color: #8ECAE6; font-size: 7px; letter-spacing: .1em; }.fb-budget-visual__head--second { margin-top: 14px; }
.fb-budget-track { height: 12px; overflow: hidden; border-radius: 20px; background: #163F51; }.fb-budget-track i { display: block; width: var(--fb-progress, 0%); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #FFB703, #FB8500); }.fb-budget-track--orange i { background: linear-gradient(90deg, #219EBC, #8ECAE6); }
.fb-budget-visual__labels { display: flex; justify-content: space-between; color: #7899A9; font-size: 8px; }
.fb-dashboard__foot { margin: 0 -1px -2px; padding: 19px 8px 5px; border-top: 1px solid rgba(142,202,230,.12); }

/* CAPABILITIES — four balanced text + animated-visual cards */
.fb-capabilities { padding: clamp(100px, 11vw, 155px) 0; background: var(--fb-bg); }
.fb-capabilities__intro { max-width: 810px; margin-bottom: 56px; }
.fb-capabilities__intro > p { max-width: 510px; margin: 22px 0 0; color: var(--fb-text); font-size: 15px; line-height: 1.9; }
.fb-capability-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 17px; align-items: stretch; }
.fb-capability { position: relative; min-width: 0; min-height: 365px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(150px, .82fr); grid-template-rows: auto 1fr; align-items: center; gap: 16px 22px; overflow: hidden; padding: 27px; border: 1px solid rgba(142,202,230,.15); border-radius: 22px; background: linear-gradient(145deg, #073047, #032638 80%); isolation: isolate; transition: border-color .35s ease, transform .35s ease, box-shadow .35s ease; }
.fb-capability::after { position: absolute; z-index: -1; right: -20%; bottom: -45%; width: 75%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(33,158,188,.11), transparent 70%); content: ''; pointer-events: none; }
.fb-capability:hover { transform: translateY(-5px); border-color: rgba(33,158,188,.38); box-shadow: 0 24px 55px rgba(0,0,0,.18); }
.fb-capability--record { background: radial-gradient(ellipse at 100% 60%, rgba(33,158,188,.09), transparent 45%), linear-gradient(145deg, #073047, #032638 80%); }
.fb-capability--future { background: radial-gradient(ellipse at 90% 90%, rgba(255,183,3,.08), transparent 48%), linear-gradient(145deg, #073047, #032638); }
.fb-capability--budget { background: radial-gradient(ellipse at 100% 100%, rgba(33,158,188,.11), transparent 48%), linear-gradient(145deg, #073047, #032638); }
.fb-capability--export { background: radial-gradient(ellipse at 90% 40%, rgba(251,133,0,.08), transparent 42%), linear-gradient(145deg, #073047, #032638); }
.fb-capability__top { grid-column: 1 / -1; grid-row: 1; display: flex; justify-content: space-between; align-items: center; gap: 15px; color: #8ECAE6; font-size: 8px; font-weight: 700; letter-spacing: .14em; }
.fb-capability__icon { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; border: 1px solid rgba(142,202,230,.2); border-radius: 12px; background: rgba(255,255,255,.025); color: var(--fb-amber); }
.fb-capability__icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
.fb-capability__icon--record svg { animation: fb-icon-record 3.2s ease-in-out infinite; }
.fb-capability__icon--future svg { animation: fb-icon-clock 7s linear infinite; }
.fb-capability__icon--budget svg { animation: fb-icon-budget 4.8s ease-in-out infinite; }
.fb-capability__icon--export svg { animation: fb-icon-export 2.8s ease-in-out infinite; }
.fb-capability__copy { position: relative; z-index: 2; grid-column: 1; grid-row: 2; align-self: center; max-width: none; margin: 0; }
.fb-capability__copy h3 { margin: 0; color: #F5FAFC; font-size: clamp(25px, 2.45vw, 34px); font-weight: 500; letter-spacing: -.05em; line-height: 1.08; }
.fb-capability__copy h3 em { color: var(--fb-sky); font-style: normal; }
.fb-capability__copy p { max-width: 310px; margin: 14px 0 0; color: #A4BBC7; font-size: 13px; line-height: 1.85; }

/* Record animation: transaction rows enter in a calm stagger. */
.fb-transaction-art { position: relative; grid-column: 2; grid-row: 2; align-self: center; display: grid; gap: 9px; min-width: 0; margin: 0; padding: 0; }
.fb-transaction-art__row { position: relative; display: flex; align-items: center; gap: 9px; min-width: 0; padding: 12px 10px; overflow: hidden; border: 1px solid rgba(142,202,230,.13); border-radius: 12px; background: rgba(255,255,255,.025); animation: fb-row-float 4.5s ease-in-out infinite; }
.fb-transaction-art__row:nth-child(2) { animation-delay: -.8s; }
.fb-transaction-art__row:nth-child(3) { animation-delay: -1.6s; }
.fb-transaction-art__row > i { display: grid; width: 29px; height: 29px; flex: 0 0 29px; place-items: center; border-radius: 9px; font-style: normal; }
.fb-transaction-art__row > i.is-blue { background: rgba(33,158,188,.15); color: #219EBC; }
.fb-transaction-art__row > i.is-orange { background: rgba(251,133,0,.14); color: #FB8500; }
.fb-transaction-art__row > i.is-sky { background: rgba(142,202,230,.14); color: #8ECAE6; }
.fb-transaction-art__row span { min-width: 0; flex: 1; }
.fb-transaction-art__row b { display: block; color: #F5FAFC; font-size: 9px; }
.fb-transaction-art__row small { display: block; margin-top: 3px; color: #7899A9; font-size: 7px; }
.fb-transaction-art__row strong { font-size: 8px; letter-spacing: .08em; }
.fb-transaction-art__scan { position: absolute; right: 8px; bottom: 5px; left: 8px; height: 1px; background: linear-gradient(90deg, transparent, rgba(142,202,230,.8), transparent); opacity: 0; animation: fb-record-scan 4s ease-in-out infinite; }

/* Future animation: recurring timeline with a softly rotating clock. */
.fb-future-art { position: relative; grid-column: 2; grid-row: 2; align-self: center; display: grid; gap: 16px; min-width: 0; margin: 0; padding: 0; }
.fb-future-art__clock { position: relative; width: 61px; height: 61px; margin: 0 auto 2px; border: 1px solid rgba(255,183,3,.35); border-radius: 50%; background: radial-gradient(circle, rgba(255,183,3,.12), rgba(255,255,255,.015)); box-shadow: 0 0 28px rgba(255,183,3,.08); }
.fb-future-art__clock::before, .fb-future-art__clock::after { position: absolute; top: 50%; left: 50%; width: 1px; height: 17px; border-radius: 2px; background: #FFB703; content: ''; transform: translate(-50%, -100%); transform-origin: bottom; animation: fb-clock-hand 8s linear infinite; }
.fb-future-art__clock::after { height: 12px; background: #8ECAE6; animation-duration: 2.4s; }
.fb-future-art__clock i { position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; border-radius: 50%; background: #F5FAFC; transform: translate(-50%,-50%); }
.fb-future-art__timeline { display: grid; gap: 8px; }
.fb-future-art__timeline > div { display: grid; grid-template-columns: 7px minmax(0,1fr) 7px; align-items: center; gap: 8px; padding: 9px; border: 1px solid rgba(142,202,230,.13); border-radius: 9px; background: rgba(255,255,255,.025); }
.fb-future-art__timeline > div > i { width: 6px; height: 6px; border-radius: 50%; background: #FFB703; box-shadow: 0 0 9px rgba(255,183,3,.55); }
.fb-future-art__timeline > div:nth-child(2) > i { background: #219EBC; box-shadow: 0 0 9px rgba(33,158,188,.55); }
.fb-future-art__timeline > div:nth-child(3) > i { background: #8ECAE6; box-shadow: 0 0 9px rgba(142,202,230,.55); }
.fb-future-art__timeline span { min-width: 0; }
.fb-future-art__timeline b { display: block; color: #F5FAFC; font-size: 8px; font-weight: 600; }
.fb-future-art__timeline small { display: block; margin-top: 2px; color: #7899A9; font-size: 7px; }
.fb-future-art__timeline em { width: 6px; height: 6px; border-top: 1px solid #8ECAE6; border-right: 1px solid #8ECAE6; transform: rotate(45deg); }

/* Budget animation: animated multi-colour progress tracks. */
.fb-budget-art { position: relative; grid-column: 2; grid-row: 2; align-self: center; display: grid; gap: 22px; min-width: 0; margin: 0; padding: 0; }
.fb-budget-art__item { display: grid; gap: 8px; }
.fb-budget-art__item > span { color: #8ECAE6; font-size: 7px; font-weight: 700; letter-spacing: .12em; }
.fb-budget-art__track { height: 11px; overflow: hidden; border-radius: 20px; background: #163F51; }
.fb-budget-art__track i { display: block; width: 72%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #FFB703, #FB8500); transform-origin: left; animation: fb-budget-fill 3.5s ease-in-out infinite alternate; }
.fb-budget-art__item--second .fb-budget-art__track i { width: 54%; background: linear-gradient(90deg, #219EBC, #8ECAE6); animation-delay: -1.3s; }
.fb-budget-art__item small { color: #7899A9; font-size: 7px; }
.fb-budget-art__pulse { position: absolute; right: 0; top: 0; width: 6px; height: 6px; border-radius: 50%; background: #FFB703; box-shadow: 0 0 13px #FFB703; animation: fb-budget-pulse 2.3s ease-in-out infinite; }

/* Export animation: two floating file cards and a moving download indicator. */
.fb-file-art { position: relative; grid-column: 2; grid-row: 2; align-self: center; display: grid; grid-template-columns: 1fr 1fr; gap: 9px; min-width: 0; margin: 0; padding: 0; }
.fb-file-art__document { position: relative; min-height: 145px; display: flex; flex-direction: column; align-items: flex-start; padding: 13px 11px; overflow: hidden; border: 1px solid rgba(142,202,230,.18); border-radius: 12px; background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.015)); box-shadow: 0 12px 27px rgba(0,0,0,.17); animation: fb-file-float 4.4s ease-in-out infinite; }
.fb-file-art__document--csv { animation-delay: -1.7s; }
.fb-file-art__type { display: grid; width: 37px; height: 37px; place-items: center; border-radius: 9px; background: rgba(255,183,3,.13); color: #FFB703; font-size: 12px; font-weight: 700; letter-spacing: .03em; }
.fb-file-art__document--csv .fb-file-art__type { background: rgba(33,158,188,.14); color: #8ECAE6; }
.fb-file-art__document > i { width: 80%; height: 3px; margin-top: 10px; border-radius: 5px; background: rgba(142,202,230,.22); }
.fb-file-art__document > i:nth-of-type(2) { width: 62%; margin-top: 6px; }
.fb-file-art__document > i:nth-of-type(3) { width: 72%; margin-top: 6px; }
.fb-file-art__document > b { position: absolute; right: 12px; bottom: 10px; color: #FFB703; font-size: 17px; font-weight: 500; animation: fb-download-bounce 1.8s ease-in-out infinite; }
.fb-file-art__document--csv > b { color: #219EBC; animation-delay: -.9s; }
.fb-file-art__mini-chart { height: 31px; display: flex; align-items: end; gap: 4px; margin-top: 12px; }
.fb-file-art__mini-chart i { width: 6px; border-radius: 3px 3px 1px 1px; background: linear-gradient(180deg, #8ECAE6, #219EBC); animation: fb-export-bars 1.7s ease-in-out infinite alternate; }
.fb-file-art__mini-chart i:nth-child(1) { height: 42%; }
.fb-file-art__mini-chart i:nth-child(2) { height: 75%; animation-delay: -.2s; }
.fb-file-art__mini-chart i:nth-child(3) { height: 56%; animation-delay: -.4s; }
.fb-file-art__mini-chart i:nth-child(4) { height: 95%; animation-delay: -.6s; }
.fb-file-art__mini-chart i:nth-child(5) { height: 67%; animation-delay: -.8s; }
.fb-file-art__status { grid-column: 1 / -1; display: flex; align-items: center; gap: 7px; margin-top: 3px; color: #8EA8B6; font-size: 6px; letter-spacing: .12em; }
.fb-file-art__status > i { width: 6px; height: 6px; border-radius: 50%; background: #2A9D8F; box-shadow: 0 0 9px #2A9D8F; }
.fb-file-art__status > em { flex: 1; height: 2px; overflow: hidden; border-radius: 2px; background: #163F51; }
.fb-file-art__status > em::after { display: block; width: 45%; height: 100%; background: #219EBC; content: ''; animation: fb-export-progress 2.8s ease-in-out infinite; }

/* PRIVACY */
.fb-privacy { position: relative; padding: clamp(105px, 11vw, 155px) 0; overflow: clip; background: #061F2D; }
.fb-privacy::before { position: absolute; top: -30%; right: -22%; width: 70vw; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(33,158,188,.09), transparent 69%); content: ''; pointer-events: none; }
.fb-privacy__intro { position: relative; z-index: 1; max-width: 850px; margin-bottom: 66px; }.fb-privacy__intro h2 { margin: 22px 0 0; color: #F5FAFC; font-size: clamp(48px, 6.5vw, 83px); font-weight: 500; letter-spacing: -.06em; line-height: 1.01; }.fb-privacy__intro h2 em { color: #8ECAE6; font-style: normal; }.fb-privacy__intro p { max-width: 530px; margin: 23px 0 0; color: #B8CBD4; font-size: 15px; line-height: 1.9; }
.fb-privacy-composition { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: clamp(50px, 8vw, 110px); }
.fb-privacy-visual { position: sticky; top: 130px; min-height: 420px; display: grid; place-items: center; overflow: hidden; border: 1px solid rgba(142,202,230,.12); border-radius: 24px; background: radial-gradient(circle at 50% 50%, rgba(33,158,188,.09), transparent 60%), #032638; }
.fb-privacy-visual__aura { position: absolute; width: 78%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(33,158,188,.2), rgba(255,183,3,.07) 45%, transparent 70%); filter: blur(23px); animation: fb-bio-aura 6s ease-in-out infinite alternate; }
.fb-biometric { position: relative; z-index: 2; width: min(70%, 260px); aspect-ratio: 1; display: grid; place-items: center; border: 1px solid rgba(142,202,230,.16); border-radius: 28px; background: linear-gradient(145deg, rgba(10,53,72,.82), rgba(1,24,37,.45)); box-shadow: 0 25px 65px rgba(0,0,0,.2), inset 0 0 35px rgba(33,158,188,.07); }
.fb-biometric svg { width: 100%; height: 100%; overflow: visible; }
.fb-biometric__frame { fill: none; stroke: rgba(142,202,230,.65); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.fb-biometric__fingerprint { fill: none; stroke: url(#fb-bio-stroke); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 460; stroke-dashoffset: 0; filter: drop-shadow(0 0 5px rgba(33,158,188,.28)); animation: fb-fingerprint-pulse 3.6s ease-in-out infinite; }
.fb-biometric__core { fill: none; stroke: #FFB703; stroke-width: 2.5; stroke-linecap: round; opacity: .8; }
.fb-biometric__scanline { position: absolute; top: 17%; left: 12%; width: 76%; height: 2px; border-radius: 4px; background: linear-gradient(90deg, transparent, #219EBC 16%, #8ECAE6 50%, #FFB703 84%, transparent); box-shadow: 0 0 12px rgba(33,158,188,.65), 0 0 25px rgba(33,158,188,.22); animation: fb-biometric-scan 3.2s cubic-bezier(.45,0,.55,1) infinite alternate; }
.fb-biometric__scan-glow { position: absolute; top: 17%; left: 12%; width: 76%; height: 45px; background: linear-gradient(180deg, rgba(33,158,188,.12), transparent); pointer-events: none; animation: fb-biometric-scan 3.2s cubic-bezier(.45,0,.55,1) infinite alternate; }
.fb-privacy-caption { position: absolute; bottom: 23px; display: flex; align-items: center; gap: 9px; color: #8EA8B6; font-size: 7px; letter-spacing: .15em; }.fb-privacy-caption i { width: 6px; height: 6px; border-radius: 50%; background: #2A9D8F; box-shadow: 0 0 12px #2A9D8F; }
.fb-privacy-points { border-top: 1px solid rgba(142,202,230,.18); }.fb-privacy-point { position: relative; display: grid; grid-template-columns: 35px 1fr 20px; align-items: start; gap: 16px; padding: 25px 0; border-bottom: 1px solid rgba(142,202,230,.18); transition: padding .3s ease; }.fb-privacy-point:hover { padding-inline: 9px; }.fb-privacy-point__number { padding-top: 2px; color: #FFB703; font-size: 9px; letter-spacing: .1em; }.fb-privacy-point > div > span { color: #8ECAE6; font-size: 8px; font-weight: 700; letter-spacing: .13em; }.fb-privacy-point h3 { margin: 9px 0 7px; color: #F5FAFC; font-size: 23px; font-weight: 500; letter-spacing: -.035em; }.fb-privacy-point p { max-width: 510px; margin: 0; color: #A4BBC7; font-size: 13px; line-height: 1.9; }.fb-privacy-point > b { padding-top: 2px; color: #8ECAE6; font-size: 16px; font-weight: 400; transition: color .2s ease, transform .2s ease; }.fb-privacy-point:hover > b { color: #FFB703; transform: translate(3px,-3px); }
.fb-privacy__policy { display: inline-flex; align-items: center; gap: 9px; margin-top: 28px; padding-bottom: 7px; border-bottom: 1px solid rgba(142,202,230,.35); color: #8ECAE6 !important; font-size: 11px; font-weight: 600; transition: gap .2s ease, color .2s ease; }.fb-privacy__policy:hover { gap: 14px; color: #FFB703 !important; }

/* FAQ */
.fb-faq { padding: clamp(100px, 11vw, 150px) 0; background: var(--fb-bg); }
.fb-faq__layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: clamp(50px, 9vw, 125px); }
.fb-faq__intro h2 { margin: 22px 0 0; color: #F5FAFC; font-size: clamp(45px, 5.5vw, 70px); font-weight: 500; letter-spacing: -.06em; line-height: 1.04; }.fb-faq__intro h2 em { color: #8ECAE6; font-style: normal; }.fb-faq__intro p { max-width: 340px; margin: 22px 0 25px; color: #A4BBC7; font-size: 14px; line-height: 1.9; }.fb-inline-link { display: inline-flex; align-items: center; gap: 9px; color: #8ECAE6 !important; font-size: 11px; font-weight: 700; transition: gap .2s ease, color .2s ease; }.fb-inline-link:hover { gap: 14px; color: #FFB703 !important; }
.fb-faq-list { border-top: 1px solid var(--fb-border); }.fb-faq-item { border-bottom: 1px solid var(--fb-border); }.fb-faq-item summary { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 35px 22px 0; color: #F5FAFC; font-family: 'Instrument Sans', sans-serif; font-size: 18px; font-weight: 500; letter-spacing: -.02em; cursor: pointer; list-style: none; }.fb-faq-item summary::-webkit-details-marker { display: none; }.fb-faq-item summary::after { position: absolute; right: 5px; color: #8ECAE6; font-family: 'Inter', sans-serif; font-size: 21px; content: '+'; transition: transform .25s ease, color .25s ease; }.fb-faq-item[open] summary::after { color: #FFB703; content: '−'; transform: rotate(180deg); }.fb-faq-item p { max-width: 650px; margin: -2px 0 23px; color: #A4BBC7; font-size: 14px; line-height: 1.95; }

/* FINAL CTA */
.fb-cta-section { padding: 0 0 clamp(85px, 10vw, 130px); background: var(--fb-bg); }
.fb-cta-panel { position: relative; min-height: 490px; display: flex; align-items: center; overflow: hidden; padding: clamp(38px, 7vw, 86px); border: 1px solid rgba(142,202,230,.22); border-radius: 29px; background: radial-gradient(ellipse at 100% 0%, rgba(33,158,188,.12), transparent 47%), linear-gradient(115deg, #073047, #032638 70%, #061F2D); isolation: isolate; }
.fb-cta-panel__glow { position: absolute; z-index: -1; top: -80%; right: -8%; width: 68%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(255,183,3,.13), rgba(33,158,188,.1) 42%, transparent 70%); filter: blur(30px); }
.fb-cta-panel__copy { position: relative; z-index: 2; max-width: 680px; }.fb-cta-panel h2 { margin: 22px 0 0; color: #F5FAFC; font-size: clamp(48px, 6.5vw, 82px); font-weight: 500; letter-spacing: -.065em; line-height: 1.01; }.fb-cta-panel h2 em { color: #8ECAE6; font-style: normal; }.fb-cta-panel__copy > p { max-width: 470px; margin: 22px 0 27px; color: #B8CBD4; font-size: 15px; line-height: 1.9; }.fb-cta-panel__copy > small { display: block; margin-top: 17px; color: #8EA8B6; font-size: 9px; }
.fb-cta-art { position: absolute; top: 50%; right: 8%; width: 230px; display: grid; justify-items: center; gap: 18px; transform: translateY(-50%); animation: fb-logo-float 7s ease-in-out infinite; }
.fb-cta-art__glow { position: absolute; z-index: -1; width: 120%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(33,158,188,.22), rgba(142,202,230,.08) 44%, transparent 70%); filter: blur(20px); }
.fb-cta-art__tile { position: relative; width: 174px; aspect-ratio: 1; display: grid; place-items: center; padding: 12px; overflow: hidden; border: 1px solid rgba(142,202,230,.3); border-radius: 34px; background: linear-gradient(145deg, #0A3548, #011825); box-shadow: 0 30px 75px rgba(0,0,0,.36), 0 0 35px rgba(33,158,188,.12), inset 0 0 0 1px rgba(255,255,255,.035); }
.fb-cta-art__tile::after { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(125deg, rgba(255,255,255,.13), transparent 35% 68%, rgba(142,202,230,.07)); content: ''; pointer-events: none; }
.fb-cta-art__tile img { display: block; width: 100%; height: 100%; object-fit: contain; border-radius: 24px; }
.fb-cta-art__label { color: rgba(142,202,230,.82); font-size: 8px; font-weight: 700; letter-spacing: .17em; text-align: center; }
.fb-cta-panel__footer { position: absolute; right: 30px; bottom: 22px; left: 30px; display: flex; justify-content: space-between; gap: 15px; padding-top: 15px; border-top: 1px solid rgba(142,202,230,.14); color: #7899A9; font-size: 7px; letter-spacing: .14em; }.fb-cta-panel__footer a { color: #8ECAE6; }

/* RESPONSIVE */
@media (max-width: 1050px) {
  .fb-hero__layout { grid-template-columns: minmax(0,.95fr) minmax(390px,1.05fr); gap: 20px; }
  .fb-hero-art { min-height: 580px; }.fb-phone { width: 285px; }
  .fb-story__layout { gap: 45px; }.fb-story-stage { min-height: 490px; }
  .fb-privacy-composition { gap: 45px; }
  .fb-cta-art { right: 4%; width: 205px; }
}
@media (max-width: 820px) {
  .finly-b .container { width: min(calc(100% - 44px), 700px); }
  .fb-hero { min-height: auto; padding: 135px 0 100px; }
  .fb-hero__layout { grid-template-columns: 1fr; gap: 15px; }
  .fb-hero__copy { max-width: 720px; }.fb-hero h1 { font-size: clamp(64px, 10vw, 88px); }
  .fb-hero-art { min-height: 610px; }.fb-phone { width: 300px; }
  .fb-story__layout { display: flex; flex-direction: column; gap: 24px; }
  .fb-story__steps { order: 2; }
  .fb-story__visual-wrap { display: contents; }
  .fb-story__visual-sticky { position: sticky; top: 82px; z-index: 20; order: 1; width: 100%; }
  .fb-story-step { min-height: 55vh; padding: 30px 0; opacity: .38; }
  .fb-story-step.is-active { opacity: 1; }
  .fb-insights__intro { display: block; }.fb-insights__intro > p { max-width: 550px; margin-top: 22px; }
  .fb-privacy-composition { grid-template-columns: 1fr; }.fb-privacy-visual { position: relative; top: auto; min-height: 360px; }
  .fb-faq__layout { grid-template-columns: 1fr; gap: 42px; }
  .fb-cta-art { right: -2%; width: 165px; opacity: .75; }
}
@media (max-width: 600px) {
  .finly-b .container { width: min(calc(100% - 38px), 520px); }
  .fb-hero { padding: 122px 0 92px; }
  .fb-kicker { margin-bottom: 22px; font-size: 8px; }.fb-hero h1 { font-size: clamp(49px, 13vw, 70px); }
