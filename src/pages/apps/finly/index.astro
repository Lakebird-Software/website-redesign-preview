<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');

/* FINLY-B — all page-specific selectors are prefixed fb- */
html[data-page-theme="finly"] { color-scheme: dark !important; }
html[data-page-theme="finly"] body { background: #011825 !important; color: #F5FAFC !important; }
html[data-page-theme="finly"] .theme-toggle { display: none !important; }
html[data-page-theme="finly"] .site-header .nav-link.is-current { color: #B8CBD4 !important; }
html[data-page-theme="finly"] .site-header .nav-link.is-current::after { transform: scaleX(0) !important; }
html[data-page-theme="finly"] .site-header .site-header__inner { background: rgba(1,24,37,.65); border-color: rgba(142,202,230,.13); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
html[data-page-theme="finly"] .site-footer { background: #061F2D; }

.finly-b {
  --fb-bg: #011825;
  --fb-bg-alt: #061F2D;
  --fb-surface: #023047;
  --fb-card: #032638;
  --fb-card-raised: #0A3548;
  --fb-border: rgba(142,202,230,.15);
  --fb-border-strong: rgba(142,202,230,.27);
  --fb-white: #F5FAFC;
  --fb-text: #B8CBD4;
  --fb-muted: #8EA8B6;
  --fb-blue: #219EBC;
  --fb-sky: #8ECAE6;
  --fb-amber: #FFB703;
  --fb-orange: #FB8500;
  --fb-green: #2A9D8F;
  position: relative;
  isolation: isolate;
  overflow: clip;
  background: var(--fb-bg);
  color: var(--fb-white);
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
.finly-b *, .finly-b *::before, .finly-b *::after { box-sizing: border-box; }
.finly-b h1, .finly-b h2, .finly-b h3, .finly-b p { margin-top: 0; }
.finly-b h1, .finly-b h2, .finly-b h3 { font-family: 'Instrument Sans', sans-serif; }
.finly-b a { color: inherit; text-decoration: none; }
.finly-b a:focus-visible, .finly-b summary:focus-visible { outline: 2px solid var(--fb-amber); outline-offset: 5px; }
.finly-b .container { width: min(calc(100% - clamp(36px, 9vw, 144px)), 1280px); margin-inline: auto; }
.fb-eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--fb-sky); font-size: 10px; font-weight: 700; letter-spacing: .15em; line-height: 1.65; text-transform: uppercase; }
.fb-eyebrow::before { width: 6px; height: 6px; flex: 0 0 6px; border-radius: 50%; background: var(--fb-blue); box-shadow: 0 0 14px rgba(33,158,188,.65); content: ''; }

/* HERO */
.fb-hero { position: relative; min-height: min(930px, max(740px, 100svh)); display: flex; flex-direction: column; justify-content: center; overflow: hidden; padding: 150px 0 110px; background: var(--fb-bg); isolation: isolate; }
.fb-hero__texture { position: absolute; z-index: -3; inset: 0; background-image: linear-gradient(rgba(142,202,230,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(142,202,230,.025) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(180deg, black, transparent 94%); }
.fb-hero__glow { position: absolute; z-index: -2; width: 55vw; max-width: 780px; aspect-ratio: 1; border-radius: 50%; filter: blur(110px); pointer-events: none; }
