.fb-manifesto__index { color: #7899A9; font-size: 8px; letter-spacing: .13em; white-space: nowrap; }
.fb-manifesto__index b { margin-left: 8px; color: var(--fb-amber); font-size: 14px; }

/* STICKY STORY — inspired by MindFlow's 100vh process blocks */
.fb-story { position: relative; padding: clamp(100px, 11vw, 150px) 0 90px; background: var(--fb-bg); }
.fb-story__heading { max-width: 760px; margin-bottom: clamp(55px, 7vw, 90px); }
.fb-story__heading h2 { margin: 22px 0 0; color: var(--fb-white); font-size: clamp(46px, 6vw, 78px); font-weight: 500; letter-spacing: -.06em; line-height: 1.02; }
.fb-story__heading h2 em { color: var(--fb-sky); font-style: normal; }
.fb-story__heading p { max-width: 560px; margin: 22px 0 0; color: var(--fb-text); font-size: 15px; line-height: 1.9; }
.fb-story__layout { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); align-items: start; gap: clamp(50px, 8vw, 110px); }
.fb-story__steps { position: relative; }
.fb-story-step { position: relative; min-height: 62vh; display: flex; flex-direction: column; justify-content: center; padding: 40px 0; border-top: 1px solid var(--fb-border); opacity: .42; transition: opacity .45s ease; }
