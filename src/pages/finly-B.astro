<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const page = document.querySelector<HTMLElement>('[data-finly-b]');

  if (page) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (themeColor) themeColor.content = '#011825';

    // Keep the shared header and footer useful on this independent route.
    header?.querySelectorAll('.nav-link.is-current').forEach((link) => link.classList.remove('is-current'));
    const backToTop = document.querySelector<HTMLAnchorElement>('.back-to-top');
    if (backToTop) {
      backToTop.href = '#finly-b-top';
      backToTop.addEventListener('click', (event) => {
        event.preventDefault();
        document.getElementById('finly-b-top')?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
      });
    }

    const faqItems = Array.from(page.querySelectorAll<HTMLDetailsElement>('.fb-faq-item'));
    faqItems.forEach((item) => item.addEventListener('toggle', () => {
      if (item.open) faqItems.forEach((other) => { if (other !== item) other.open = false; });
    }));

    if (!reducedMotion) {
      const context = gsap.context(() => {
        // Hero: layered editorial reveal.
        const hero = gsap.timeline({ defaults: { ease: 'power3.out' } });
        hero.from('[data-fb-hero-kicker]', { autoAlpha: 0, y: 16, duration: .65 })
          .from('[data-fb-hero-title] .fb-title-line', { autoAlpha: 0, yPercent: 115, duration: .95, stagger: .15 }, '-=.25')
          .from('[data-fb-hero-lead]', { autoAlpha: 0, y: 22, duration: .75 }, '-=.48')
          .from('[data-fb-hero-actions] > *', { autoAlpha: 0, y: 16, duration: .6, stagger: .1 }, '-=.42')
          .from('[data-fb-hero-facts]', { autoAlpha: 0, y: 12, duration: .55 }, '-=.35')
          .from('.fb-phone', { autoAlpha: 0, y: 35, scale: .94, duration: 1.05 }, '-=.95')
          .from('.fb-glass-note', { autoAlpha: 0, y: 18, duration: .7, stagger: .13 }, '-=.65');

        // Gentle pointer parallax on the hero product composition.
        const heroElement = page.querySelector<HTMLElement>('.fb-hero');
        const phone = page.querySelector<HTMLElement>('[data-fb-phone]');
        if (heroElement && phone && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
          const onPointer = (event: PointerEvent) => {
            const rect = heroElement.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - .5;
            const y = (event.clientY - rect.top) / rect.height - .5;
            gsap.to(phone, { x: x * 9, y: y * 8, duration: .7, ease: 'power2.out', overwrite: 'auto' });
          };
          const reset = () => gsap.to(phone, { x: 0, y: 0, duration: .8, ease: 'power3.out', overwrite: 'auto' });
          heroElement.addEventListener('pointermove', onPointer, { passive: true });
          heroElement.addEventListener('pointerleave', reset, { passive: true });
        }

        // Reveal the editorial sections only when they enter the viewport.
        page.querySelectorAll<HTMLElement>('[data-fb-reveal]').forEach((element) => {
          gsap.fromTo(element, { autoAlpha: 0, y: 28 }, {
            autoAlpha: 1, y: 0, duration: .85, ease: 'power3.out',
            scrollTrigger: { trigger: element, start: 'top 86%', once: true }
          });
        });

        // MindFlow-inspired process: each scroll chapter changes one sticky visual.
        const steps = Array.from(page.querySelectorAll<HTMLElement>('[data-fb-step]'));
        const states = Array.from(page.querySelectorAll<HTMLElement>('[data-fb-state]'));
        const stateLabel = page.querySelector<HTMLElement>('[data-fb-state-label]');
        const labels = ['01 / RECORD', '02 / UNDERSTAND', '03 / PLAN', '04 / KEEP CONTROL'];
        const activateState = (index: number) => {
          steps.forEach((step, i) => step.classList.toggle('is-active', i === index));
          states.forEach((state, i) => {
            const active = i === index;
            state.classList.toggle('is-active', active);
            state.setAttribute('aria-hidden', String(!active));
            if (active) {
              gsap.fromTo(state, { y: 18, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .48, ease: 'power2.out', overwrite: true });
              animateVisualState(state);
            }
          });
          if (stateLabel) stateLabel.textContent = labels[index] || labels[0];
        };

        const animatedStates = new WeakSet<HTMLElement>();
        const animateVisualState = (state: HTMLElement) => {
          if (animatedStates.has(state)) return;
          animatedStates.add(state);
          const slices = state.querySelectorAll<SVGCircleElement>('[data-fb-donut]');
          slices.forEach((slice, i) => {
            const dash = slice.getAttribute('stroke-dasharray')?.split(/\s+/) || [];
            const length = Number(dash[0] || 0);
            gsap.fromTo(slice, { strokeDasharray: `0 572`, opacity: .45 }, { strokeDasharray: `${length} 572`, opacity: 1, duration: 1.05, delay: i * .07, ease: 'power2.out' });
          });
          state.querySelectorAll<HTMLElement>('[data-fb-progress]').forEach((bar) => {
            const target = Number(bar.dataset.fbProgress || 0);
            gsap.to(bar, { width: `${target}%`, duration: 1.05, ease: 'power3.out' });
          });
        };

        steps.forEach((step, index) => {
          ScrollTrigger.create({
            trigger: step,
            start: 'top 56%',
            end: 'bottom 44%',
            onEnter: () => activateState(index),
            onEnterBack: () => activateState(index)
          });
        });
        activateState(0);

        // Dashboard charts: animate on first entrance, not continuously.
        page.querySelectorAll<HTMLElement>('[data-fb-chart]').forEach((chart) => {
          ScrollTrigger.create({
            trigger: chart,
            start: 'top 82%',
            once: true,
            onEnter: () => {
              const segments = chart.querySelectorAll<SVGCircleElement>('[data-fb-segment]');
              segments.forEach((segment, index) => {
                const first = Number(segment.getAttribute('stroke-dasharray')?.split(/\s+/)[0] || 0);
                gsap.fromTo(segment, { strokeDasharray: `0 427`, opacity: .45 }, { strokeDasharray: `${first} 427`, opacity: 1, duration: 1.15, delay: index * .07, ease: 'power2.out' });
              });
              gsap.fromTo(chart.querySelectorAll<HTMLElement>('[data-fb-bar]'), { scaleY: 0, transformOrigin: 'bottom' }, { scaleY: 1, duration: .9, stagger: .06, ease: 'power3.out' });
              chart.querySelectorAll<SVGPathElement>('[data-fb-line]').forEach((path, index) => {
                const length = path.getTotalLength();
                gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
                gsap.to(path, { strokeDashoffset: 0, duration: 1.7, delay: index * .2, ease: 'power2.inOut' });
              });
              chart.querySelectorAll<HTMLElement>('[data-fb-progress]').forEach((bar) => {
                const target = Number(bar.dataset.fbProgress || 0);
                gsap.to(bar, { width: `${target}%`, duration: 1.1, ease: 'power3.out' });
              });
            }
          });
        });

        // Small depth shift on the privacy emblem as it reaches the viewport.
        const privacyVisual = page.querySelector<HTMLElement>('.fb-privacy-visual');
        if (privacyVisual) {
          gsap.fromTo(privacyVisual, { y: 28, autoAlpha: 0 }, {
            y: 0, autoAlpha: 1, duration: .9, ease: 'power3.out',
            scrollTrigger: { trigger: privacyVisual, start: 'top 82%', once: true }
          });
        }
      }, page);

      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
      window.addEventListener('pagehide', () => context.revert(), { once: true });
    }
  }
</script>
