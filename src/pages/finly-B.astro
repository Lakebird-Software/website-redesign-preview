.fb-capability-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.fb-capability { position: relative; min-height: 445px; display: flex; flex-direction: column; overflow: hidden; padding: 27px; border: 1px solid rgba(142,202,230,.15); border-radius: 22px; background: linear-gradient(145deg, #073047, #032638 80%); isolation: isolate; transition: border-color .35s ease, transform .35s ease; }
.fb-capability:hover { transform: translateY(-5px); border-color: rgba(33,158,188,.38); }
.fb-capability--large { min-height: 545px; grid-row: span 2; }.fb-capability--future { background: radial-gradient(ellipse at 90% 90%, rgba(255,183,3,.08), transparent 48%), linear-gradient(145deg, #073047, #032638); }.fb-capability--budget { background: radial-gradient(ellipse at 100% 100%, rgba(33,158,188,.11), transparent 48%), linear-gradient(145deg, #073047, #032638); }.fb-capability--export { min-height: 400px; grid-column: 1 / -1; background: radial-gradient(ellipse at 90% 40%, rgba(251,133,0,.08), transparent 42%), linear-gradient(145deg, #073047, #032638); }
.fb-capability__top { display: flex; justify-content: space-between; align-items: center; color: #8ECAE6; font-size: 8px; font-weight: 700; letter-spacing: .14em; }.fb-capability__icon { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(142,202,230,.2); border-radius: 10px; color: var(--fb-amber); font-size: 16px; }
.fb-capability__copy { position: relative; z-index: 2; max-width: 490px; margin-top: 40px; }.fb-capability__copy h3 { margin: 0; color: #F5FAFC; font-size: clamp(28px, 3vw, 39px); font-weight: 500; letter-spacing: -.05em; line-height: 1.08; }.fb-capability__copy h3 em { color: var(--fb-sky); font-style: normal; }.fb-capability__copy p { max-width: 440px; margin: 15px 0 0; color: #A4BBC7; font-size: 13px; line-height: 1.9; }
.fb-transaction-art { display: grid; gap: 10px; margin-top: auto; padding-top: 48px; }.fb-transaction-art__row { display: flex; align-items: center; gap: 12px; padding: 15px; border: 1px solid rgba(142,202,230,.13); border-radius: 12px; background: rgba(255,255,255,.025); }.fb-transaction-art__row > i { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 9px; font-style: normal; }.fb-transaction-art__row > i.is-blue { background: rgba(33,158,188,.15); color: #219EBC; }.fb-transaction-art__row > i.is-orange { background: rgba(251,133,0,.14); color: #FB8500; }.fb-transaction-art__row > i.is-sky { background: rgba(142,202,230,.14); color: #8ECAE6; }.fb-transaction-art__row span { flex: 1; }.fb-transaction-art__row b { display: block; color: #F5FAFC; font-size: 10px; }.fb-transaction-art__row small { display: block; margin-top: 3px; color: #7899A9; font-size: 8px; }.fb-transaction-art__row strong { font-size: 9px; letter-spacing: .12em; }
