.fb-ledger__row small { display: block; margin-top: 3px; color: #7899A9; font-size: 8px; }
.fb-ledger__row strong { font-size: 9px; letter-spacing: .08em; }
.fb-ledger__tag { padding: 5px 6px; border: 1px solid rgba(142,202,230,.12); border-radius: 5px; color: #7899A9; font-size: 6px; font-style: normal; letter-spacing: .09em; }
.is-blue-text { color: #219EBC !important; }.is-orange-text { color: #FB8500 !important; }.is-sky-text { color: #8ECAE6 !important; }.is-gold-text { color: #FFB703 !important; }
.fb-state__foot { display: flex; align-items: center; gap: 10px; margin-top: 25px; color: #7899A9; font-size: 7px; letter-spacing: .1em; }
