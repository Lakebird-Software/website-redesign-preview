.fb-budget-art { display: grid; gap: 18px; margin-top: auto; padding-top: 35px; }.fb-budget-art > div { display: grid; gap: 8px; }.fb-budget-art span { color: #8ECAE6; font-size: 7px; letter-spacing: .12em; }.fb-budget-art b { display: block; width: 100%; height: 10px; border-radius: 20px; background: linear-gradient(90deg, #FFB703 0 68%, #163F51 68%); }.fb-budget-art > div:nth-child(2) b { background: linear-gradient(90deg, #219EBC 0 43%, #163F51 43%); }.fb-budget-art > div > i { display: block; width: 70%; height: 1px; background: rgba(142,202,230,.12); }
