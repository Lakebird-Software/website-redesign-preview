.fb-analysis-legend i, .fb-chart-key i { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 3px; background: var(--swatch); box-shadow: 0 0 9px color-mix(in srgb, var(--swatch), transparent 58%); }
.fb-state__disclaimer { margin: 17px 0 0; color: #7899A9; font-size: 8px; line-height: 1.7; }
.fb-budget-list { display: grid; gap: 19px; margin-top: 35px; }
.fb-budget-row { display: grid; grid-template-columns: 1fr auto; gap: 11px; }
.fb-budget-row > div:first-child span { display: block; color: #F5FAFC; font-size: 10px; font-weight: 600; }
