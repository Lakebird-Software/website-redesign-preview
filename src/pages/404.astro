---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found — Lakebird Software" description="The page you are looking for could not be found." canonicalPath="/404/">
  <section class="placeholder-page section-pad">
    <div class="container placeholder-page__inner">
      <span class="eyebrow">LAKEBIRD SOFTWARE / 404</span>
      <h1>Lost in the orbit.</h1>
      <h2>This page doesn't exist.</h2>
      <p>The address may have changed, or the page may still be taking shape.</p>
      <a class="button button--primary" href={base}>Return to home <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
